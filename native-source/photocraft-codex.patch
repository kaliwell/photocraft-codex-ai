+#[cfg(not(target_arch = "wasm32"))]
+mod native {
+    use super::{Context, Shared, Value, json, l};
+    use std::io::{Read, Write};
+    use std::net::{Ipv4Addr, SocketAddr, TcpStream};
+    use std::time::{Duration, Instant};
+
+    pub(super) fn request(method: &str, path: &str, body: &Value) -> Result<Value, String> {
+        let port: u16 = std::env::var("PHOTOCRAFT_CODEX_PORT").ok().and_then(|s| s.parse().ok()).ok_or(l("Local Codex service is not configured"))?;
+        let token_file = std::env::var_os("PHOTOCRAFT_CODEX_TOKEN_FILE").ok_or(l("Local authentication file is not configured"))?;
+        let token = std::fs::read_to_string(token_file).map_err(|_| l("Cannot read local authentication file"))?;
+        let token = token.trim();
+        if token.len() != 64 || !token.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(l("Invalid local authentication file"));
+        }
+        let address = SocketAddr::from((Ipv4Addr::LOCALHOST, port));
+        let mut stream = TcpStream::connect_timeout(&address, Duration::from_secs(3)).map_err(|e| format!("Cannot connect to Codex service: {e}"))?;
+        stream.set_read_timeout(Some(Duration::from_secs(5))).map_err(|e| e.to_string())?;
+        stream.set_write_timeout(Some(Duration::from_secs(5))).map_err(|e| e.to_string())?;
+        let body = body.to_string();
+        let wire = format!(
+            "{method} {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nAuthorization: Bearer {token}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+            body.len()
+        );
+        stream.write_all(wire.as_bytes()).map_err(|e| e.to_string())?;
+        let mut response = String::new();
+        let limit = if path == "/history/restore" { 350 * 1024 * 1024 + 65536 } else { 65536 };
+        stream.take(limit + 1).read_to_string(&mut response).map_err(|e| e.to_string())?;
+        if response.len() as u64 > limit {
+            return Err(l("History response exceeds the local size guard"));
+        }
+        let (_, body) = response.split_once("\r\n\r\n").ok_or(l("Invalid response from Codex service"))?;
+        let value: Value = serde_json::from_str(body).map_err(|e| e.to_string())?;
+        if value.get("error").and_then(Value::as_bool) == Some(true) && value.get("busy").is_none() {
+            return Err(value.get("message").and_then(Value::as_str).unwrap_or("Codex request failed").into());
+        }
+        Ok(value)
+    }
+
+    pub(super) fn run(ctx: &Context, state: &Shared, body: Value) -> Result<(), String> {
+        let timeout = if body.get("mode").and_then(Value::as_str) == Some("batch") {
+            body.get("references").and_then(Value::as_array).map_or(1200, |items| (items.len() as u64).saturating_mul(660).saturating_add(1200))
+        } else {
+            1200
+        };
+        request("POST", "/generate", &body)?;
+        let started = Instant::now();
+        loop {
+            let response = request("GET", "/state", &json!({}))?;
+            let busy = response.get("busy").and_then(Value::as_bool).unwrap_or(false);
+            {
+                let mut status = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+                status.busy = busy;
+                status.message = response.get("message").and_then(Value::as_str).unwrap_or("Processing…").chars().take(1000).collect();
+                status.error = response.get("error").and_then(Value::as_bool).unwrap_or(false);
+                status.history_notice = response.get("history_warning").and_then(Value::as_str).unwrap_or("").to_owned();
+            }
+            ctx.request_repaint();
+            if !busy {
+                return Ok(());
+            }
+            if started.elapsed() > Duration::from_secs(timeout) {
+                return Err(l("Generation timed out; check the local job logs"));
+            }
+            std::thread::sleep(Duration::from_millis(500));
+        }
+    }
+}
