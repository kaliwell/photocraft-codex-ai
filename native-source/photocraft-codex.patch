+#[test]
+fn clipboard_export_copies_the_whole_canvas_even_with_selection_and_mirroring_disabled() {
+    let os = OsClip::default();
+    let output = os.clone();
+    let services = Services {
+        clipboard_set_image: Some(Box::new(move |w, h, bytes| {
+            *output.lock().unwrap() = Some((w, h, bytes.to_vec()));
+            Ok(())
+        })),
+        ..Default::default()
+    };
+    let mut app = PhotocraftApp::new(Session::new(), services);
+    app.session.execute("file.new", serde_json::json!({"width":16,"height":12,"background":"transparent"})).unwrap();
+    app.session.execute("prefs.set", serde_json::json!({"path":"general.exportClipboard","value":false})).unwrap();
+    app.run("select.rect", serde_json::json!({"x":2,"y":3,"width":4,"height":5})).unwrap();
+    let before = app.session.active().unwrap().doc.clone();
+    let revision = app.session.active().unwrap().revision;
+    assert!(crate::menus::is_enabled(&app, "file.export.clipboard"));
+    let result = crate::menus::invoke(&mut app, &egui::Context::default(), "file.export.clipboard", serde_json::Value::Null).unwrap();
+    assert_eq!(result, serde_json::json!({"width":16,"height":12,"copied":true}));
+    let (w, h, bytes) = os.lock().unwrap().clone().unwrap();
+    assert_eq!((w, h, bytes.len()), (16, 12, 16 * 12 * 4));
+    assert!(bytes.as_chunks::<4>().0.iter().all(|pixel| pixel[3] == 0));
+    assert_eq!(app.session.active().unwrap().doc, before);
+    assert_eq!(app.session.active().unwrap().revision, revision);
+    assert!(!app.ui.status_error);
+}
