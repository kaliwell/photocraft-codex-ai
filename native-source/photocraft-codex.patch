+/// Authenticated automation can attach image bytes it already holds, never arbitrary local paths.
+pub(crate) fn attach_request(app: &mut PhotocraftApp, ctx: &Context, params: &Value) -> Result<Value, String> {
+    let object = params.as_object().ok_or("Expected an object")?;
+    if object.len() != 1 {
+        return Err("Expected only references".into());
+    }
+    if let Some(paths) = object.get("paths") {
+        let paths = paths.as_array().ok_or("Expected paths array")?;
+        let read = app.services.automation_read.as_mut().ok_or("Automation file reads are unavailable")?;
+        let mut files = Vec::new();
+        let mut total = 0;
+        for path in paths {
+            let path = path.as_str().ok_or("Expected image path")?;
+            let result = read(path)?;
+            let (name, bytes) = (result.name, result.bytes);
+            total += bytes.len();
+            if bytes.len() > MAX_REFERENCE_BYTES || total > MAX_REFERENCE_TOTAL {
+                return Err("Local transfer memory guard exceeded".into());
+            }
+            files.push((name, bytes));
+        }
+        return queue_references(ctx.clone(), crate::FileDialogAnswer::ContentsMany(files));
+    }
+    let references = object.get("references").and_then(Value::as_array).ok_or("Expected references array")?;
+    let mut total = 0;
+    for reference in references {
+        let object = reference.as_object().ok_or("Invalid reference")?;
+        let name = object.get("name").and_then(Value::as_str).ok_or("Missing name")?;
+        let data = object.get("data").and_then(Value::as_str).ok_or("Missing image data")?;
+        if object.len() != 2 || name.is_empty() || name.chars().count() > 255 || data.len() > 4 * MAX_REFERENCE_BYTES.div_ceil(3) {
+            return Err("Invalid reference payload".into());
+        }
+        total += data.len();
+        if total > 350 * 1024 * 1024 {
+            return Err("Local transfer memory guard exceeded".into());
+        }
+    }
+    let references = references.clone();
+    queue_reference_input(ctx.clone(), move || {
+        use base64::Engine;
+        let files = references
+            .into_iter()
+            .map(|r| {
+                let name = r["name"].as_str().ok_or("Missing name")?.to_string();
+                let data = base64::engine::general_purpose::STANDARD.decode(r["data"].as_str().ok_or("Missing data")?).map_err(|e| e.to_string())?;
+                Ok((name, data))
+            })
+            .collect::<Result<Vec<_>, String>>()?;
+        Ok(crate::FileDialogAnswer::ContentsMany(files))
+    })
+}
+
+fn queue_reference_input(ctx: Context, input: impl FnOnce() -> Result<crate::FileDialogAnswer, String> + Send + 'static) -> Result<Value, String> {
+    let state = shared(&ctx);
+    {
+        let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.busy || state.loading {
+            return Err(l("Please wait for the current task to finish"));
+        }
+        state.loading = true;
+    }
+    let work = move || {
+        let (count, total) = {
+            let state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            (state.references.len(), state.references.iter().map(|r| r.bytes).sum())
+        };
+        let result = input().and_then(|answer| read_references(answer, &ctx, count, total));
+        {
+            let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.loading = false;
+            match result {
+                Ok(files) => {
+                    state.references.extend(files);
+                    state.error = false;
+                    state.message = pt!("Reference images selected: {}", state.references.len());
+                }
+                Err(e) => {
+                    state.error = true;
+                    state.message = e;
+                }
+            }
+        }
+        ctx.request_repaint();
+    };
+    #[cfg(not(target_arch = "wasm32"))]
+    std::thread::spawn(work);
+    #[cfg(target_arch = "wasm32")]
+    work();
+    Ok(json!({"references":"loading"}))
+}
+
+/// Only files dropped on the visible AI composer become references; all other drops retain File/Open behavior.
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn accept_drop(ctx: &Context, files: &[egui::DroppedFileHandle], at: Option<egui::Pos2>) -> bool {
+    if files.is_empty() {
+        return false;
+    }
+    let state = shared(ctx);
+    let on_composer = {
+        let state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        at.or_else(|| ctx.pointer_hover_pos()).is_some_and(|p| state.rect.is_some_and(|r| r.contains(p)) || state.sidebar_rect.is_some_and(|r| r.contains(p)))
+    };
+    if !on_composer {
+        return false;
+    }
+    ctx.input_mut(|i| i.raw.dropped_files.clear());
+    let files = files.to_vec();
+    if let Err(error) = queue_reference_input(ctx.clone(), move || read_dragged(files)) {
+        let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.message = error;
+        state.error = true;
+    }
+    true
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn accept_drop(_ctx: &Context, _files: &[egui::DroppedFileHandle], _at: Option<egui::Pos2>) -> bool {
+    false
+}
