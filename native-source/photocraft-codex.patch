+        app.run("select.rect", json!({"x": 20, "y": 30, "width": 80, "height": 60})).unwrap();
+        let ctx = Context::default();
+        let xf = ViewXform {
+            rect: Rect::from_min_size(pos2(0.0, 0.0), vec2(400.0, 300.0)),
+            zoom: 1.0,
+            center: [200.0, 150.0],
+            flip: false,
+            rotation: 0.0,
+            aspect: 1.0,
+        };
+        assert_eq!(selection_rect(&app, &ctx, xf).unwrap().width(), 80.0);
+        assert_eq!(selection_rect(&app, &ctx, ViewXform { zoom: 2.0, ..xf }).unwrap().width(), 160.0);
+        app.run("select.rect", json!({"x": 40, "y": 50, "width": 100, "height": 70})).unwrap();
+        assert_eq!(selection_rect(&app, &ctx, xf).unwrap().width(), 100.0);
+        app.run("select.deselect", json!({})).unwrap();
+        assert!(selection_rect(&app, &ctx, xf).is_none());
+    }
+}
