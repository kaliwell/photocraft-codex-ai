+fn centered_shapes_preserve_pixels_selection_and_restore_with_history_at_all_depths() {
+    for depth in [SampleType::U8, SampleType::U16, SampleType::F32] {
+        let mut doc = Document::new("AI mask", Size::new(80, 60), ColorMode::Rgb, depth);
+        let mut layer = Layer::raster("Generated", doc.pixel_format());
+        layer.surface_mut().unwrap().fill_rect(Rect::new(20, 10, 60, 50), &[0.2, 0.4, 0.8, 1.0]);
+        let id = layer.id;
+        let pixels = layer.surface().unwrap().clone();
+        doc.layers.push(layer);
+        doc.selection = Some(Surface::with_default(PixelFormat::GRAY8, &[0.25]));
+        let selection = doc.selection.clone();
+        let mut s = Session::new();
+        s.add_document(doc, None);
+        s.execute(EDIT, json!({"layer": id.0, "shape": "circle", "feather": 12})).unwrap();
+        let circle = s.active().unwrap().doc.layer(id).unwrap().mask.as_ref().unwrap().clone();
+        assert_eq!(circle.surface.sample_channel(20, 10, 0), 0.0);
+        assert_eq!(circle.surface.sample_channel(40, 30, 0), 1.0);
+        s.execute(EDIT, json!({"layer": id.0, "shape": "square"})).unwrap();
+        let square = s.active().unwrap().doc.layer(id).unwrap().mask.as_ref().unwrap().clone();
+        assert_eq!(square.surface.sample_channel(20, 10, 0), 1.0);
+        assert_eq!(square.feather, 12.0);
+        s.execute("edit.undo", json!({})).unwrap();
+        assert_eq!(s.active().unwrap().doc.layer(id).unwrap().mask.as_ref(), Some(&circle));
+        s.execute("edit.redo", json!({})).unwrap();
+        s.execute(EDIT, json!({"layer": id.0, "shape": "selection", "feather": 0})).unwrap();
+        let current = s.active().unwrap();
+        assert_eq!(current.doc.layer(id).unwrap().surface(), Some(&pixels));
+        assert_eq!(current.doc.selection, selection);
+        assert_eq!(current.doc.layer(id).unwrap().mask.as_ref().unwrap().feather, 0.0);
+        let revision = current.revision;
+        for shape in [json!("triangle"), json!(null), json!(5)] {
+            assert!(s.execute(EDIT, json!({"layer": id.0, "shape": shape})).is_err());
+            assert_eq!(s.active().unwrap().revision, revision);
+        }
+    }
+}
