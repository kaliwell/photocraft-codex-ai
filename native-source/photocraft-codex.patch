+#[test]
+#[cfg(not(target_arch = "wasm32"))]
+fn image_export_uses_chosen_folder_for_unsaved_projects() {
+    let (mut app, open, _) = app();
+    let ctx = egui::Context::default();
+    let folder = std::env::temp_dir().join(format!(
+        "photocraft-export-picker-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+    ));
+    let before = app.session.active().unwrap().doc.clone();
+    crate::image_export::choose(&mut app, true).unwrap();
+    app.poll_file_dialog(&ctx, None);
+    assert!(matches!(open.borrow().first().map(|(r, _)| r), Some(FileDialogRequest::Folder { .. })));
+    answer(&open, Some(FileDialogAnswer::FolderTo(folder.to_string_lossy().into())));
+    app.poll_file_dialog(&ctx, None);
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(30);
+    loop {
+        if std::fs::read_dir(&folder).is_ok_and(|mut entries| entries.any(|e| e.is_ok_and(|e| e.path().extension().is_some_and(|e| e == "png")))) {
+            break;
+        }
+        assert!(std::time::Instant::now() < deadline);
+        std::thread::sleep(std::time::Duration::from_millis(20));
+    }
+    assert!(std::sync::Arc::ptr_eq(&before, &app.session.active().unwrap().doc));
+    assert!(app.session.active().unwrap().path.is_none());
+    std::fs::remove_dir_all(folder).unwrap();
+}
