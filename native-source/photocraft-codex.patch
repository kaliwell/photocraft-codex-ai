+                            .hint_text(l("Describe what to edit or generate…"))
+                            .char_limit(4000)
+                            .desired_width(f32::INFINITY),
+                    );
+                    input_rect = Some(input.rect);
+                    prompt_focused = input.has_focus();
+                    button_rects.extend(actions(app, ui, &snapshot));
+                    sidebar::references(app, ctx, &snapshot, ui, &mut button_rects);
+                    button_rects.extend(sidebar::controls(app, ctx, &snapshot, ui));
+
+                    if snapshot.loading {
