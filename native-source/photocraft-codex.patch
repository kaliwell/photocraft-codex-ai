+
+fn queue_clipboard_image(ctx: &Context, width: u32, height: u32, rgba: Vec<u8>) -> Result<Value, String> {
+    let bytes = u64::from(width).checked_mul(u64::from(height)).and_then(|n| n.checked_mul(4)).unwrap_or(u64::MAX);
+    if width == 0 || height == 0 || bytes > MAX_REFERENCE_TOTAL as u64 || bytes != rgba.len() as u64 {
+        return Err(l("Clipboard image is invalid or too large"));
+    }
+    queue_reference_input(ctx.clone(), move || {
+        let image = photocraft_codecs::Image::from_u8(width, height, photocraft_codecs::ChannelLayout::Rgba, rgba).map_err(|e| e.to_string())?;
+        let png = photocraft_codecs::encode(&image, photocraft_codecs::Format::Png, &Default::default()).map_err(|e| e.to_string())?;
+        Ok(crate::FileDialogAnswer::Contents("clipboard.png".into(), png))
+    })
+}
+
+fn paste_reference(app: &mut PhotocraftApp, ctx: &Context) -> Result<Value, String> {
+    let image = app.services.clipboard_get_image.as_mut().ok_or_else(|| l("Clipboard image reading is unavailable"))?()?;
+    let (w, h, rgba) = image.ok_or_else(|| l("No image in the clipboard"))?;
+    queue_clipboard_image(ctx, w, h, rgba)
+}
+
+/// Only the visible composer owns image pastes while hovered or its prompt has focus.
+/// Text-only pastes and pastes elsewhere retain the editor's existing behavior.
+pub fn paste_events(app: &mut PhotocraftApp, ctx: &Context) {
+    let state = shared(ctx);
+    {
+        let mut s = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if s.suppress_paste_release {
+            ctx.input_mut(|i| {
+                i.events.retain(|e| {
+                    if matches!(e, egui::Event::Key { key: egui::Key::V, pressed: false, .. }) {
+                        s.suppress_paste_release = false;
+                        s.paste_command_seen = false;
+                        false
+                    } else {
+                        true
+                    }
+                })
+            });
+        }
+    }
+    if !app.ui.dialogs.is_empty() || app.ui.shell.dialog.is_some() || app.long_cut.is_some() {
+        return;
+    }
+    let targeted = {
+        let s = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        s.prompt_focused || ctx.pointer_hover_pos().is_some_and(|p| s.rect.is_some_and(|r| r.contains(p)) || s.sidebar_rect.is_some_and(|r| r.contains(p)))
+    };
+    if !targeted || app.session.active().is_none_or(|d| d.doc.selection.is_none()) {
+        return;
+    }
+    let command_seen = {
+        let mut s = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        ctx.input(|i| {
+            if i.modifiers.command || i.events.iter().any(|e| matches!(e, egui::Event::ModifiersChanged(m) if m.command)) {
+                s.paste_command_seen = true;
+            }
+            if i.events.iter().any(|e| matches!(e, egui::Event::Key { key, pressed: true, modifiers, .. } if *key != egui::Key::V || !modifiers.command)) {
+                s.paste_command_seen = false;
+            }
+        });
+        s.paste_command_seen
+    };
+    let (image, requested) = ctx.input(|i| {
+        (
+            i.events.iter().find_map(|e| if let egui::Event::PasteImage(image) = e { Some(image.clone()) } else { None }),
+            i.events.iter().any(|e| {
+                matches!(e, egui::Event::Paste(_))
+                    || matches!(e, egui::Event::Key { key: egui::Key::V, pressed, modifiers, .. } if modifiers.command || (!pressed && command_seen))
+            }),
+        )
+    });
+    let result = if let Some(image) = image {
+        let rgba = image.pixels.iter().flat_map(|p| p.to_srgba_unmultiplied()).collect();
+        Some(queue_clipboard_image(ctx, image.width() as u32, image.height() as u32, rgba))
+    } else if requested {
+        match app.services.clipboard_get_image.as_mut().map(|get| get()) {
+            Some(Ok(Some((w, h, rgba)))) => Some(queue_clipboard_image(ctx, w, h, rgba)),
+            Some(Err(e)) => Some(Err(e)),
+            _ => None,
+        }
+    } else {
+        None
+    };
+    if let Some(result) = result {
+        state.lock().unwrap_or_else(std::sync::PoisonError::into_inner).suppress_paste_release =
+            !ctx.input(|i| i.events.iter().any(|e| matches!(e, egui::Event::Key { key: egui::Key::V, pressed: false, .. })));
+        state.lock().unwrap_or_else(std::sync::PoisonError::into_inner).paste_command_seen = false;
+        ctx.input_mut(|i| {
+            i.events.retain(|e| !matches!(e, egui::Event::Paste(_) | egui::Event::PasteImage(_)) && !matches!(e, egui::Event::Key { key: egui::Key::V, .. }))
+        });
+        if let Err(error) = result {
+            reference_error(ctx, error);
+        }
+    }
+}
