+    ("参考图超过本地传输保护阈值 256 MiB。", "Reference images exceed the local 256 MiB transfer guard."),
+    ("参考图编码无效。", "Invalid reference-image encoding."),
+    ("参考图大小超出限制。", "Reference image exceeds the local size guard."),
+    ("参考图超过本地解码保护阈值 1 亿像素。", "Reference image exceeds the local 100-million-pixel decode guard."),
+];
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn translations_preserve_dynamic_fields() {
+        for code in ["zh-hans", "zh-hant"] {
+            let lang = crate::i18n::Lang::from_code(code).unwrap();
+            for template in super::TEMPLATES {
+                assert_eq!(template.matches("{}").count(), crate::i18n::tr(lang, template).matches("{}").count(), "{code}: {template}");
+            }
+        }
+    }
+    #[test]
+    fn language_switch_updates_existing_dynamic_messages() {
+        let zh = crate::i18n::Lang::from_code("zh-hans").unwrap();
+        crate::i18n::with_language(zh, || {
+            assert_eq!(super::text("Fill selection"), "局部修改");
+            assert_eq!(super::text("Paste reference image"), "粘贴参考图");
+            assert_eq!(super::text("No image in the clipboard"), "剪贴板中没有图片");
+            assert_eq!(super::text("Reference images selected: 5"), "已选择 5 张参考图");
+            assert_eq!(super::text("Processing image request · waiting 48 s"), "正在处理生图请求 · 已等待 48 秒");
+        });
+        crate::i18n::with_language(crate::i18n::Lang::EN, || {
+            assert_eq!(super::text("已选择 5 张参考图"), "Reference images selected: 5");
+            assert_eq!(super::text("Long image cutter"), "Long image cutter");
+        });
+    }
+}
