+pub fn show(app: &mut PhotocraftApp, ctx: &Context, xf: ViewXform) {
+    if !available() {
+        return;
+    }
+    let status = shared(ctx);
+    {
+        let mut state = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.rect = None;
+        state.sidebar_rect = None;
+        state.input = None;
+        state.buttons.clear();
+        state.prompt_focused = false;
+        let context = history::document_context(app);
+        if state.history_context != context {
+            state.history_context = context;
+            state.history_rows.clear();
+            state.history_open = false;
+            state.history_prompt = None;
+            state.history_options = None;
+            state.history_references = None;
+        }
+        if let Some(prompt) = state.history_prompt.take() {
+            app.ui.codex_ai_prompt = prompt;
+            if let Some(options) = state.history_options.take() {
+                app.ui.codex_layout_options = options;
+            }
+            if let Some(references) = state.history_references.take() {
+                state.references = references;
+            }
+        }
+        state.current_prompt = app.ui.codex_ai_prompt.clone();
+    }
+    if !app.ui.dialogs.is_empty() || app.ui.shell.dialog.is_some() || app.long_cut.is_some() {
+        return;
+    }
+    let snapshot = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+    let Some(selection) = selection_rect(app, ctx, xf).or_else(|| snapshot.busy.then(|| Rect::from_center_size(xf.rect.center(), vec2(1.0, 1.0)))) else {
+        history::show(app, ctx);
+        layout_options::show(app, ctx);
+        return;
+    };
+    if !selection.intersects(xf.rect) || xf.rect.width() < 320.0 || xf.rect.height() < 150.0 {
+        return;
+    }
