+//! Flat image exports from immutable document snapshots; never save or switch projects.
+use crate::{PhotocraftApp, plugin_i18n::text as l};
+use serde_json::Value;
+#[cfg(not(target_arch = "wasm32"))]
+use serde_json::json;
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+    mpsc,
+};
+
+#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+#[serde(default)]
+pub struct Settings {
+    extension: String,
+    quality: u8,
+    webp_lossless: bool,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self { extension: "png".into(), quality: 90, webp_lossless: true }
+    }
+}
+impl Settings {
+    fn format(&self) -> Result<photocraft_codecs::Format, String> {
+        photocraft_codecs::from_extension(&self.extension).filter(|f| f.caps().write).ok_or_else(|| "Unsupported export format".into())
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    fn options(&self) -> photocraft_io::ExportOptions {
+        let mut options = photocraft_io::ExportOptions::default();
+        options.encode.jpeg_quality = self.quality.clamp(1, 100);
+        options.encode.webp_quality = self.quality.clamp(1, 100);
+        options.encode.webp_lossless = self.webp_lossless;
+        options
+    }
+}
+
+pub(crate) fn settings_menu(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    let settings = &mut app.ui.image_export_settings;
+    let format = settings.format().unwrap_or(photocraft_codecs::Format::Png);
+    if settings.format().is_err() {
+        settings.extension = "png".into();
+    }
+    ui.menu_button(format!("{}: {}", l("Format"), format.name()), |ui| {
+        egui::ScrollArea::vertical().max_height(260.0).show(ui, |ui| {
+            for format in photocraft_codecs::Format::ALL.into_iter().filter(|f| f.caps().write) {
+                if let Some(ext) = format.extensions().first() {
+                    ui.selectable_value(&mut settings.extension, (*ext).into(), format.name());
+                }
+            }
+        });
+    });
+    let format = settings.format().unwrap_or(photocraft_codecs::Format::Png);
+    if format == photocraft_codecs::Format::WebP {
+        ui.checkbox(&mut settings.webp_lossless, l("Lossless"));
+    }
+    if matches!(format, photocraft_codecs::Format::Jpeg | photocraft_codecs::Format::Avif)
+        || (format == photocraft_codecs::Format::WebP && !settings.webp_lossless)
+    {
+        ui.add(egui::Slider::new(&mut settings.quality, 1..=100).text(l("Quality")));
+    }
+    if format == photocraft_codecs::Format::Jpeg {
+        ui.label(l("JPEG does not support transparency"));
+    }
+    ui.separator();
+}
+
+#[derive(Default)]
+pub(crate) struct State {
+    format_name: String,
+    receiver: Option<mpsc::Receiver<Event>>,
+    cancel: Arc<AtomicBool>,
+    busy: bool,
+    total: usize,
+    done: usize,
+    files: Vec<String>,
+    errors: Vec<String>,
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn filenames_are_windows_safe() {
+        assert_eq!(file_stem("CON.psd"), "_CON");
+        assert_eq!(file_stem("ab?.psd"), "ab_");
+        assert_eq!(file_stem("..."), "image");
+        assert_eq!(file_stem("海报.psb"), "海报");
+    }
+
+    #[test]
+    fn settings_reject_import_only_formats_and_preserve_defaults() {
+        for extension in ["heic", "xcf", "pcx", "../../bad", "psd"] {
+            assert!(Settings { extension: extension.into(), ..Default::default() }.format().is_err());
+        }
+        let default: Settings = serde_json::from_str("{}").unwrap();
+        assert_eq!(default.extension, "png");
+        assert_eq!(default.quality, 90);
+        let restored: Settings =
+            serde_json::from_str(&serde_json::to_string(&Settings { extension: "jpg".into(), quality: 98, webp_lossless: false }).unwrap()).unwrap();
+        assert_eq!(restored.format().unwrap(), photocraft_codecs::Format::Jpeg);
+        assert_eq!(restored.options().encode.jpeg_quality, 98);
+    }
+
+    #[test]
+    fn selected_formats_use_real_encoders_and_matching_extensions() {
+        let folder = std::env::temp_dir().join(format!(
+            "photocraft-formats-test-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        app.run("file.new", json!({"width":32,"height":48})).unwrap();
+        for extension in ["png", "jpg", "webp", "tif", "bmp", "gif"] {
+            app.ui.image_export_settings.extension = extension.into();
+            app.image_export = None;
+            start(&mut app, false, Some(folder.to_string_lossy().into())).unwrap();
+            let rx = app.image_export.as_ref().unwrap().receiver.as_ref().unwrap();
+            let Event::Item(result) = rx.recv_timeout(std::time::Duration::from_secs(30)).unwrap() else { panic!("missing output") };
+            let path = result.unwrap();
+            assert!(path.ends_with(&format!(".{extension}")));
+            let bytes = std::fs::read(&path).unwrap();
+            let doc = photocraft_io::import(&path, &bytes).unwrap().document;
+            assert_eq!(doc.size.width, 32);
+            assert_eq!(doc.size.height, 48);
+            assert!(matches!(rx.recv_timeout(std::time::Duration::from_secs(30)).unwrap(), Event::Finished));
+        }
+        std::fs::remove_dir_all(folder).unwrap();
+    }
+
+    #[test]
+    fn repeated_exports_preserve_existing_files() {
+        let folder = std::env::temp_dir().join(format!(
+            "photocraft-export-test-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        let first = write_unique(&folder, "poster", "png", b"first").unwrap();
+        let second = write_unique(&folder, "poster", "png", b"second").unwrap();
+        assert!(second.ends_with("poster_2.png"));
+        assert_eq!(std::fs::read(first).unwrap(), b"first");
+        assert_eq!(std::fs::read(second).unwrap(), b"second");
+        std::fs::remove_dir_all(folder).unwrap();
+    }
+
+    #[test]
+    fn batch_exports_full_canvases_without_mutating_projects() {
+        let folder = std::env::temp_dir().join(format!(
+            "photocraft-batch-test-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        for (w, h) in [(32, 48), (64, 40)] {
+            app.run("file.new", json!({"width":w,"height":h})).unwrap();
+        }
+        app.run("select.rect", json!({"x":0,"y":0,"width":4,"height":4})).unwrap();
+        let active = app.session.active_index();
+        let snapshots: Vec<_> = app.session.documents().iter().map(|s| s.doc.clone()).collect();
+        start(&mut app, true, Some(folder.to_string_lossy().into())).unwrap();
+        assert!(start(&mut app, false, None).is_err());
+        let rx = app.image_export.as_ref().unwrap().receiver.as_ref().unwrap();
+        let mut sizes = Vec::new();
+        while let Event::Item(result) = rx.recv_timeout(std::time::Duration::from_secs(30)).unwrap() {
+            let bytes = std::fs::read(result.unwrap()).unwrap();
+            assert_eq!(&bytes[..8], b"\x89PNG\r\n\x1a\n");
+            sizes.push((u32::from_be_bytes(bytes[16..20].try_into().unwrap()), u32::from_be_bytes(bytes[20..24].try_into().unwrap())));
+        }
+        assert_eq!(sizes, [(32, 48), (64, 40)]);
+        assert_eq!(app.session.active_index(), active);
+        for (s, before) in app.session.documents().iter().zip(snapshots) {
+            assert!(Arc::ptr_eq(&s.doc, &before));
+            assert!(s.path.is_none());
+        }
+        std::fs::remove_dir_all(folder).unwrap();
+    }
+}
+#[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+enum Event {
+    Item(Result<String, String>),
+    Finished,
+}
+
+#[cfg(any(not(target_arch = "wasm32"), test))]
+fn file_stem(name: &str) -> String {
+    let stem = std::path::Path::new(name).file_stem().and_then(|s| s.to_str()).unwrap_or("image");
+    let clean: String = stem.chars().take(100).map(|c| if c.is_control() || "<>:\"/\\|?*".contains(c) { '_' } else { c }).collect();
+    let clean = clean.trim_matches([' ', '.']);
+    if clean.is_empty() {
+        return "image".into();
+    }
+    let upper = clean.to_ascii_uppercase();
+    if [
+        "CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6",
+        "LPT7", "LPT8", "LPT9",
+    ]
+    .contains(&upper.as_str())
+    {
+        format!("_{clean}")
+    } else {
+        clean.to_string()
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn write_unique(folder: &std::path::Path, stem: &str, extension: &str, bytes: &[u8]) -> Result<String, String> {
+    use std::{fs, io::Write};
+    fs::create_dir_all(folder).map_err(|e| e.to_string())?;
+    for i in 1..=10000 {
+        let filename = if i == 1 { format!("{stem}.{extension}") } else { format!("{stem}_{i}.{extension}") };
+        let path = folder.join(filename);
+        let mut file = match fs::OpenOptions::new().write(true).create_new(true).open(&path) {
+            Ok(f) => f,
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => continue,
+            Err(e) => return Err(e.to_string()),
+        };
+        if let Err(error) = file.write_all(bytes) {
+            drop(file);
+            let _ = fs::remove_file(&path);
+            return Err(error.to_string());
+        }
+        return Ok(path.to_string_lossy().into_owned());
+    }
+    Err("Too many existing exports".into())
+}
+
+pub(crate) fn start(app: &mut PhotocraftApp, all: bool, folder: Option<String>) -> Result<Value, String> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (app, all, folder);
+        Err("not available on the web".into())
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        if app.image_export.as_ref().is_some_and(|s| s.busy) {
+            return Err(l("Please wait for the current task to finish"));
+        }
+        let active = app.session.active_index().ok_or("No document")?;
+        let settings = app.ui.image_export_settings.clone();
+        let format = settings.format()?;
+        let extension = *format.extensions().first().ok_or("No export extension")?;
+        let jobs: Vec<_> =
+            app.session.documents().iter().enumerate().filter(|(i, _)| all || *i == active).map(|(_, s)| (s.doc.clone(), s.path.clone())).collect();
+        let (tx, rx) = mpsc::channel();
+        let cancel = Arc::new(AtomicBool::new(false));
+        let flag = cancel.clone();
+        app.image_export = Some(State { format_name: format.name().into(), receiver: Some(rx), cancel, busy: true, total: jobs.len(), ..Default::default() });
+        std::thread::spawn(move || {
+            for (doc, path) in jobs {
+                if flag.load(Ordering::Relaxed) {
+                    break;
+                }
+                let result = (|| {
+                    let output = match &folder {
+                        Some(folder) => std::path::PathBuf::from(folder),
+                        None => std::path::Path::new(path.as_deref().ok_or("Save this project first, or choose an export folder")?)
+                            .parent()
+                            .ok_or("No project folder")?
+                            .join("导出图片"),
+                    };
+                    if !output.is_absolute() {
+                        return Err("Choose an absolute export folder".to_string());
+                    }
+                    let bytes = photocraft_io::export(&doc, extension, &settings.options()).map_err(|e| e.to_string())?;
+                    if flag.load(Ordering::Relaxed) {
+                        return Err("Cancelled".to_string());
+                    }
+                    write_unique(&output, &file_stem(path.as_deref().unwrap_or(&doc.name)), extension, &bytes.bytes)
+                })()
+                .map_err(|e: String| format!("{}: {e}", doc.name));
+                let _ = tx.send(Event::Item(result));
+            }
+            let _ = tx.send(Event::Finished);
+        });
+        Ok(json!({"started":true}))
+    }
+}
+
+pub(crate) fn choose(app: &mut PhotocraftApp, all: bool) -> Result<Value, String> {
+    app.ask_folder(move |app, folder| start(app, all, Some(folder)))
+}
+
+pub(crate) fn show(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let Some(state) = app.image_export.as_mut() else {
+        return;
+    };
+    if let Some(rx) = &state.receiver {
+        loop {
+            match rx.try_recv() {
+                Ok(Event::Item(result)) => {
+                    state.done += 1;
+                    match result {
+                        Ok(p) => state.files.push(p),
+                        Err(e) => state.errors.push(e),
+                    }
+                }
+                Ok(Event::Finished) => {
+                    state.busy = false;
+                    break;
+                }
+                Err(mpsc::TryRecvError::Empty) => break,
+                Err(mpsc::TryRecvError::Disconnected) => {
+                    state.busy = false;
+                    break;
+                }
+            }
+        }
+    }
+    let mut open = true;
+    egui::Window::new(l("Export images")).open(&mut open).default_width(560.0).show(ctx, |ui| {
+        ui.label(format!("{} · {}", state.format_name, l("Full visible canvas; existing files are kept")));
+        ui.label(format!("{} / {}", state.done, state.total));
+        ui.horizontal(|ui| {
+            ui.label(l("Exported"));
+            ui.label(state.files.len().to_string());
+            ui.label(l("Failed"));
+            ui.label(state.errors.len().to_string());
+        });
+        ui.add(egui::ProgressBar::new(state.done as f32 / state.total.max(1) as f32));
+        egui::ScrollArea::vertical().max_height(300.0).show(ui, |ui| {
+            for path in &state.files {
+                ui.label(path);
+            }
+            for error in &state.errors {
+                ui.colored_label(
+                    ui.visuals().error_fg_color,
+                    error.replace("Save this project first, or choose an export folder", &l("Save this project first, or choose an export folder")),
+                );
+            }
+        });
+        if state.busy && ui.button(l("Cancel")).clicked() {
+            state.cancel.store(true, Ordering::Relaxed);
+        }
+        if !state.busy {
+            ui.label(l(if state.cancel.load(Ordering::Relaxed) {
+                "Export cancelled; completed images are kept"
+            } else {
+                "Export finished; completed images are kept"
+            }));
+        }
+    });
+    if state.busy {
+        ctx.request_repaint_after(std::time::Duration::from_millis(100));
+    }
+    if !open {
+        state.cancel.store(true, Ordering::Relaxed);
+        app.image_export = None;
+    }
+}
