+fn submit(app: &PhotocraftApp, ctx: &Context, mode: &str) {
+    let Some(doc) = app.session.active() else { return };
+    let state = shared(ctx);
+    let state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    if state.loading {
+        return;
+    }
+    let references: Vec<_> = state.references.iter().map(|r| json!({"name":r.name,"data":r.data.as_str()})).collect();
+    drop(state);
+    let mut request = json!({"mode": mode, "prompt": app.ui.codex_ai_prompt,"references":references,
+        "document": {"index": app.session.active_index(), "name": doc.doc.name, "revision": doc.revision,"insertionLayer":doc.active_layer.map(|layer|layer.0)}});
+    if mode == "layout" || mode == "detail" || mode == "batch" || mode == "reflow" {
+        request["layout_options"] = layout_options::value(app);
+    }
+    start(ctx, request);
+}
