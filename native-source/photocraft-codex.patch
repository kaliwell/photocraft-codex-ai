+fn actions(app: &mut PhotocraftApp, ui: &mut egui::Ui, status: &Status) -> Vec<(String, Rect)> {
+    let mut buttons = Vec::new();
+    ui.horizontal_wrapped(|ui| {
+        ui.add_enabled_ui(!status.busy && !status.loading, |ui| {
+            let has_prompt = !app.ui.codex_ai_prompt.trim().is_empty();
+            for (label, mode, enabled) in
+                [("Fill selection", "fill", has_prompt), ("Remove object", "remove", true), ("Generate image", "generate", has_prompt)]
+            {
+                let response = ui.add_enabled_ui(enabled, |ui| widgets::secondary_button(ui, &l(label), 76.0)).inner;
+                buttons.push((l(label), response.rect));
+                if response.clicked() {
+                    submit(app, ui.ctx(), mode);
+                }
+            }
+        });
+        let toggle = ui.button(l("PSD tools"));
+        buttons.push(("Tools sidebar".into(), toggle.rect));
+        if toggle.clicked() {
+            shared(ui.ctx()).lock().unwrap_or_else(std::sync::PoisonError::into_inner).sidebar_open = !status.sidebar_open;
+        }
+        if status.busy && widgets::secondary_button(ui, &l("Cancel"), 44.0).clicked() {
+            cancel(ui.ctx());
+        }
+    });
+    buttons
+}
