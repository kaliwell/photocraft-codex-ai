index 00000000..a5d92c67
--- /dev/null
+++ b/crates/ui-egui/src/codex_ai.rs
@@ -0,0 +1,649 @@
+//! Optional native selection toolbar. Document edits stay in the existing engine commands;
+//! an authenticated loopback worker runs Codex without blocking egui's frame loop.
+use egui::{Context, Rect, Vec2, pos2, vec2};
+use serde_json::{Value, json};
+use std::sync::{Arc, Mutex};
+
+use crate::{PhotocraftApp, canvas::ViewXform, theme::Tokens, widgets};
+
+const MAX_REFERENCE_BYTES: usize = 64 * 1024 * 1024;
+const MAX_REFERENCE_TOTAL: usize = 256 * 1024 * 1024;
+#[derive(Clone)]
+struct Reference {
+    name: String,
+    data: Arc<String>,
+    bytes: usize,
+    texture: egui::TextureHandle,
+}
+
+#[derive(Clone, Default)]
+struct Status {
+    busy: bool,
+    message: String,
+    error: bool,
+    rect: Option<Rect>,
+    input: Option<Rect>,
+    buttons: Vec<(String, Rect)>,
+    references: Vec<Reference>,
+    loading: bool,
+}
+
+type Shared = Arc<Mutex<Status>>;
+
+#[derive(Clone, Default)]
+struct BoundsCache {
+    key: Option<(photocraft_doc::DocId, u64)>,
+    bounds: Option<[f32; 4]>,
+}
+
+fn shared(ctx: &Context) -> Shared {
+    ctx.data_mut(|d| d.get_temp_mut_or_default::<Shared>(egui::Id::unique("codex-ai-status")).clone())
+}
+
+pub fn inspect(ctx: &Context) -> Value {
+    let state = shared(ctx);
+    let state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    json!({"busy": state.busy, "message": state.message, "error": state.error,
+           "referenceLoading":state.loading,"references":state.references.iter().map(|r|json!({"name":r.name,"bytes":r.bytes})).collect::<Vec<_>>(),
+           "maskFeatherMenu": crate::layer_menu_ui::inspect_feather_menu(ctx),
+           "rect": state.rect.map(|r| [r.min.x, r.min.y, r.width(), r.height()]),
+           "input": state.input.map(|r| [r.min.x, r.min.y, r.width(), r.height()]),
+           "buttons": state.buttons.iter().map(|(label, r)| json!({"label": label, "rect": [r.min.x, r.min.y, r.width(), r.height()]})).collect::<Vec<_>>()})
+}
+
+/// Place below the selection; move above it at the bottom edge and clamp to the canvas.
+fn position(selection: Rect, viewport: Rect, size: Vec2) -> egui::Pos2 {
+    let x = (selection.center().x - size.x / 2.0).clamp(viewport.left() + 8.0, (viewport.right() - size.x - 8.0).max(viewport.left() + 8.0));
+    let below = selection.bottom() + 12.0;
+    let y = if below + size.y <= viewport.bottom() - 8.0 { below } else { selection.top() - size.y - 12.0 };
+    pos2(x, y.clamp(viewport.top() + 8.0, (viewport.bottom() - size.y - 8.0).max(viewport.top() + 8.0)))
+}
+
+fn selection_rect(app: &PhotocraftApp, ctx: &Context, xf: ViewXform) -> Option<Rect> {
+    let document = app.session.active()?;
+    let key = (document.doc.id, document.revision);
+    // Exact mask bounds scan tiles. Reuse them while only the camera or ants move.
+    let bounds = ctx.data_mut(|data| {
+        let cache = data.get_temp_mut_or_default::<BoundsCache>(egui::Id::unique("codex-ai-selection-bounds"));
+        if cache.key != Some(key) {
+            cache.key = Some(key);
+            cache.bounds = document.doc.selection.as_ref().and_then(|mask| {
+                let r = mask.content_bounds();
+                (r.width() > 0 && r.height() > 0).then_some([r.x0 as f32, r.y0 as f32, r.x1 as f32, r.y1 as f32])
+            });
+        }
+        cache.bounds
+    })?;
+    let [x0, y0, x1, y1] = bounds;
+    Some(Rect::from_points(&[xf.to_screen(x0, y0), xf.to_screen(x1, y0), xf.to_screen(x0, y1), xf.to_screen(x1, y1)]))
+}
+
+pub fn show(app: &mut PhotocraftApp, ctx: &Context, xf: ViewXform) {
+    if !available() {
+        return;
+    }
+    let status = shared(ctx);
+    {
+        let mut state = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.rect = None;
+        state.input = None;
+        state.buttons.clear();
+    }
+    if !app.ui.dialogs.is_empty() || app.ui.shell.dialog.is_some() {
+        return;
+    }
+    let Some(selection) = selection_rect(app, ctx, xf) else { return };
+    if !selection.intersects(xf.rect) || xf.rect.width() < 320.0 || xf.rect.height() < 150.0 {
+        return;
+    }
+    let snapshot = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+    let width = (xf.rect.width() - 24.0).clamp(280.0, 560.0);
+    let size = vec2(width, 124.0 + if snapshot.references.is_empty() { 0.0 } else { 102.0 });
+    let anchor = position(selection, xf.rect, size);
+    let tokens = Tokens::get(ctx);
+    let mut input_rect = None;
+    let mut button_rects = Vec::new();
+    let area = egui::Area::new(egui::Id::unique("codex-ai-toolbar")).order(egui::Order::Foreground).fixed_pos(anchor).movable(false).show(ctx, |ui| {
+        ui.set_clip_rect(xf.rect);
+        egui::Frame::new().fill(tokens.card).stroke(egui::Stroke::new(1.0, tokens.card_border)).corner_radius(tokens.radius).inner_margin(10.0).show(
+            ui,
+            |ui| {
+                ui.set_width(width - 20.0);
+                let input = ui.add_enabled(
+                    !snapshot.busy && !snapshot.loading,
+                    egui::TextEdit::singleline(&mut app.ui.codex_ai_prompt).hint_text("描述要修改或生成的内容…").char_limit(4000).desired_width(f32::INFINITY),
+                );
+                input_rect = Some(input.rect);
+                ui.label("拖入图片作为参考 · 支持多张，数量由 Codex 校验");
+                button_rects = actions(app, ui, &snapshot);
+                if !snapshot.references.is_empty() {
+                    let mut remove = None;
+                    egui::ScrollArea::horizontal().id_salt("codex-reference-strip").max_height(90.0).show(ui, |ui| {
+                        ui.horizontal(|ui| {
+                            for (index, reference) in snapshot.references.iter().enumerate() {
+                                ui.vertical(|ui| {
+                                    ui.add(egui::Image::new(&reference.texture).max_size(vec2(52.0, 52.0))).on_hover_text(&reference.name);
+                                    let response = ui
+                                        .add_enabled(!snapshot.busy && !snapshot.loading, egui::Button::new(format!("{} ×", index + 1)))
+                                        .on_hover_text("移除此参考图");
+                                    button_rects.push((format!("移除参考图{}", index + 1), response.rect));
+                                    if response.clicked() {
+                                        remove = Some(index);
+                                    }
+                                });
+                            }
+                        });
+                    });
+                    if let Some(index) = remove {
+                        let mut state = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+                        state.references.remove(index);
+                        state.message = format!("已选择 {} 张参考图", state.references.len());
+                        state.error = false;
+                    }
+                }
+                if snapshot.loading {
+                    ui.label("正在读取参考图…");
+                }
+                if snapshot.busy {
+                    ui.horizontal(|ui| {
+                        ui.spinner();
+                        widgets::elided_label(ui, &snapshot.message, width - 65.0);
+                    });
+                } else if !snapshot.message.is_empty() {
+                    let text = egui::RichText::new(&snapshot.message).color(if snapshot.error { tokens.danger } else { tokens.text_dim });
+                    ui.add(egui::Label::new(text).truncate()).on_hover_text(&snapshot.message);
+                }
+            },
+        );
+    });
+    let mut state = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    state.rect = Some(area.response.rect);
+    state.input = input_rect;
+    state.buttons = button_rects;
+}
+
+fn actions(app: &mut PhotocraftApp, ui: &mut egui::Ui, status: &Status) -> Vec<(String, Rect)> {
+    let mut buttons = Vec::new();
+    ui.horizontal(|ui| {
+        ui.add_enabled_ui(!status.busy && !status.loading, |ui| {
+            let has_prompt = !app.ui.codex_ai_prompt.trim().is_empty();
+            for (label, mode, enabled) in [("局部修改", "fill", has_prompt), ("移除物体", "remove", true), ("生成图片", "generate", has_prompt)] {
+                let response = ui.add_enabled_ui(enabled, |ui| widgets::secondary_button(ui, label, 76.0)).inner;
+                buttons.push((label.into(), response.rect));
+                if response.clicked() {
+                    submit(app, ui.ctx(), mode);
+                }
+            }
+            let add = ui
+                .add_enabled(!app.file_dialog_open(), egui::Button::new(format!("参考图 {} ＋", status.references.len())))
+                .on_hover_text("一次选择多张图片；在提示词中用参考图1、参考图2指定用途");
+            buttons.push(("添加参考图".into(), add.rect));
+            if add.clicked() {
+                let ctx = ui.ctx().clone();
+                if let Err(error) = pick_references(app, &ctx) {
+                    let state = shared(&ctx);
+                    let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+                    state.message = error;
+                    state.error = true;
+                }
+            }
+        });
+        if status.busy && widgets::secondary_button(ui, "取消", 44.0).clicked() {
+            cancel(ui.ctx());
+        }
+    });
+    buttons
+}
+
+fn submit(app: &PhotocraftApp, ctx: &Context, mode: &str) {
+    let Some(doc) = app.session.active() else { return };
+    let state = shared(ctx);
+    let state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    if state.loading {
+        return;
+    }
+    let references: Vec<_> = state.references.iter().map(|r| json!({"name":r.name,"data":r.data.as_str()})).collect();
+    drop(state);
+    let request = json!({"mode": mode, "prompt": app.ui.codex_ai_prompt,"references":references,
+        "document": {"index": app.session.active_index(), "name": doc.doc.name, "revision": doc.revision}});
+    start(ctx, request);
+}
+
+fn pick_references(app: &mut PhotocraftApp, ctx: &Context) -> Result<Value, String> {
+    let ctx = ctx.clone();
+    let initial_dir = crate::file_dialog::last_used_dir(&app.ui.recent_files)
+        .or_else(|| std::env::var_os("USERPROFILE").map(|p| std::path::PathBuf::from(p).join("Desktop").to_string_lossy().into_owned()));
+    app.ask_file(
+        crate::FileDialogRequest::Open {
+            multiple: true,
+            initial_dir,
+            extensions: Some(["png", "jpg", "jpeg", "webp", "bmp", "gif", "tif", "tiff"].iter().map(|s| s.to_string()).collect()),
+        },
+        move |_, answer| queue_references(ctx, answer),
+    )
+}
+
+fn queue_references(ctx: Context, answer: crate::FileDialogAnswer) -> Result<Value, String> {
+    queue_reference_input(ctx, move || Ok(answer))
+}
+
+/// Authenticated automation can attach image bytes it already holds, never arbitrary local paths.
+pub(crate) fn attach_request(app: &mut PhotocraftApp, ctx: &Context, params: &Value) -> Result<Value, String> {
+    let object = params.as_object().ok_or("Expected an object")?;
+    if object.len() != 1 {
+        return Err("Expected only references".into());
+    }
+    if let Some(paths) = object.get("paths") {
+        let paths = paths.as_array().ok_or("Expected paths array")?;
+        let read = app.services.automation_read.as_mut().ok_or("Automation file reads are unavailable")?;
+        let mut files = Vec::new();
+        let mut total = 0;
+        for path in paths {
+            let path = path.as_str().ok_or("Expected image path")?;
+            let (name, bytes) = read(path)?;
+            total += bytes.len();
+            if bytes.len() > MAX_REFERENCE_BYTES || total > MAX_REFERENCE_TOTAL {
+                return Err("Local transfer memory guard exceeded".into());
+            }
+            files.push((name, bytes));
+        }
+        return queue_references(ctx.clone(), crate::FileDialogAnswer::ContentsMany(files));
+    }
+    let references = object.get("references").and_then(Value::as_array).ok_or("Expected references array")?;
+    let mut total = 0;
+    for reference in references {
+        let object = reference.as_object().ok_or("Invalid reference")?;
+        let name = object.get("name").and_then(Value::as_str).ok_or("Missing name")?;
+        let data = object.get("data").and_then(Value::as_str).ok_or("Missing image data")?;
+        if object.len() != 2 || name.is_empty() || name.chars().count() > 255 || data.len() > 4 * MAX_REFERENCE_BYTES.div_ceil(3) {
+            return Err("Invalid reference payload".into());
+        }
+        total += data.len();
+        if total > 350 * 1024 * 1024 {
+            return Err("Local transfer memory guard exceeded".into());
+        }
+    }
+    let references = references.clone();
+    queue_reference_input(ctx.clone(), move || {
+        use base64::Engine;
+        let files = references
+            .into_iter()
+            .map(|r| {
+                let name = r["name"].as_str().ok_or("Missing name")?.to_string();
+                let data = base64::engine::general_purpose::STANDARD.decode(r["data"].as_str().ok_or("Missing data")?).map_err(|e| e.to_string())?;
+                Ok((name, data))
+            })
+            .collect::<Result<Vec<_>, String>>()?;
+        Ok(crate::FileDialogAnswer::ContentsMany(files))
+    })
+}
+
+fn queue_reference_input(ctx: Context, input: impl FnOnce() -> Result<crate::FileDialogAnswer, String> + Send + 'static) -> Result<Value, String> {
+    let state = shared(&ctx);
+    {
+        let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.busy || state.loading {
+            return Err("请等待当前任务完成".into());
+        }
+        state.loading = true;
+    }
+    let work = move || {
+        let (count, total) = {
+            let state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            (state.references.len(), state.references.iter().map(|r| r.bytes).sum())
+        };
+        let result = input().and_then(|answer| read_references(answer, &ctx, count, total));
+        {
+            let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.loading = false;
+            match result {
+                Ok(files) => {
+                    state.references.extend(files);
+                    state.error = false;
+                    state.message = format!("已选择 {} 张参考图", state.references.len());
+                }
+                Err(e) => {
+                    state.error = true;
+                    state.message = e;
+                }
+            }
+        }
+        ctx.request_repaint();
+    };
+    #[cfg(not(target_arch = "wasm32"))]
+    std::thread::spawn(work);
+    #[cfg(target_arch = "wasm32")]
+    work();
+    Ok(json!({"references":"loading"}))
+}
+
+/// Only files dropped on the visible AI composer become references; all other drops retain File/Open behavior.
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn accept_drop(ctx: &Context, files: &[egui::DroppedFileHandle], at: Option<egui::Pos2>) -> bool {
+    if files.is_empty() {
+        return false;
+    }
+    let state = shared(ctx);
+    let on_composer = {
+        let state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.rect.zip(at.or_else(|| ctx.pointer_hover_pos())).is_some_and(|(r, p)| r.contains(p))
+    };
+    if !on_composer {
+        return false;
+    }
+    ctx.input_mut(|i| i.raw.dropped_files.clear());
+    let files = files.to_vec();
+    if let Err(error) = queue_reference_input(ctx.clone(), move || read_dragged(files)) {
+        let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.message = error;
+        state.error = true;
+    }
+    true
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn accept_drop(_ctx: &Context, _files: &[egui::DroppedFileHandle], _at: Option<egui::Pos2>) -> bool {
+    false
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn read_dragged(files: Vec<egui::DroppedFileHandle>) -> Result<crate::FileDialogAnswer, String> {
+    use std::io::Read;
+    let mut result = Vec::new();
+    let mut total = 0;
+    for file in files {
+        let path = file.path();
+        let bytes = if path.is_file() {
+            let mut bytes = Vec::new();
+            std::fs::File::open(path).map_err(|e| e.to_string())?.take(MAX_REFERENCE_BYTES as u64 + 1).read_to_end(&mut bytes).map_err(|e| e.to_string())?;
+            bytes
+        } else {
+            file.bytes()?
+        };
+        total += bytes.len();
+        if bytes.len() > MAX_REFERENCE_BYTES || total > MAX_REFERENCE_TOTAL {
+            return Err("超过本地传输内存保护阈值，请分批提交".into());
+        }
+        result.push((path.to_string_lossy().into_owned(), bytes));
+    }
+    Ok(crate::FileDialogAnswer::ContentsMany(result))
+}
+
+fn read_references(answer: crate::FileDialogAnswer, ctx: &Context, _count: usize, mut total: usize) -> Result<Vec<Reference>, String> {
+    use crate::FileDialogAnswer;
+    use base64::Engine;
+    use std::io::Read;
+    let files = match answer {
+        FileDialogAnswer::Paths(paths) => {
+            let mut files = Vec::new();
+            let mut collected = total;
+            for path in paths {
+                let mut bytes = Vec::new();
+                std::fs::File::open(&path)
+                    .map_err(|e| e.to_string())?
+                    .take(MAX_REFERENCE_BYTES as u64 + 1)
+                    .read_to_end(&mut bytes)
+                    .map_err(|e| e.to_string())?;
+                collected += bytes.len();
+                if bytes.len() > MAX_REFERENCE_BYTES || collected > MAX_REFERENCE_TOTAL {
+                    return Err("Local transfer memory guard exceeded".into());
+                }
+                files.push((path, bytes));
+            }
+            files
+        }
+        FileDialogAnswer::Contents(name, bytes) => vec![(name, bytes)],
+        FileDialogAnswer::ContentsMany(files) => files,
+        _ => return Err("图片选择结果无效".into()),
+    };
+    let mut references = Vec::new();
+    for (name, bytes) in files {
+        total += bytes.len();
+        if bytes.is_empty() || bytes.len() > MAX_REFERENCE_BYTES || total > MAX_REFERENCE_TOTAL {
+            return Err("超过本地传输内存保护阈值，请分批提交".into());
+        }
+        let options = photocraft_codecs::DecodeOptions {
+            limits: photocraft_codecs::Limits { max_width: u32::MAX, max_height: u32::MAX, max_pixels: 100_000_000, max_alloc: 1024 * 1024 * 1024 },
+            ..Default::default()
+        };
+        let image = photocraft_codecs::decode_with(&bytes, &options).map_err(|e| format!("参考图无法读取：{e}"))?;
+        let rgba = image.to_rgba8();
+        let scale = (80.0 / image.width() as f64).min(80.0 / image.height() as f64).min(1.0);
+        let w = (image.width() as f64 * scale).round().max(1.0) as usize;
+        let h = (image.height() as f64 * scale).round().max(1.0) as usize;
+        let mut preview = vec![0; w * h * 4];
+        for y in 0..h {
+            for x in 0..w {
+                let source = ((y * image.height() as usize / h) * image.width() as usize + x * image.width() as usize / w) * 4;
+                preview[(y * w + x) * 4..(y * w + x + 1) * 4].copy_from_slice(&rgba[source..source + 4]);
+            }
+        }
+        let name = std::path::Path::new(&name).file_name().map(|n| n.to_string_lossy().chars().take(255).collect::<String>()).unwrap_or_else(|| "image".into());
+        let texture = ctx.load_texture("codex-reference", egui::ColorImage::from_rgba_unmultiplied([w, h], &preview), egui::TextureOptions::LINEAR);
+        references.push(Reference { name, data: Arc::new(base64::engine::general_purpose::STANDARD.encode(&bytes)), bytes: bytes.len(), texture });
+    }
+    Ok(references)
+}
