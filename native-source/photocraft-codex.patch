+/// Build the center from the original pixel coverage, never from a previously shaped mask.
+fn centered_mask(layer: &photocraft_doc::Layer, canvas: Rect, shape: &str) -> Result<Surface> {
+    let source = layer.surface().ok_or_else(|| bad("a pixel layer is required"))?;
+    let area = photocraft_compose::bounds::content_bounds(source).intersect(&canvas);
+    if u64::from(area.width()) * u64::from(area.height()) > 64_000_000 {
+        return Err(bad("mask area exceeds 64 million pixels"));
+    }
+    let format = source.format();
+    let mut support = Surface::new(PixelFormat::new(ColorMode::Grayscale, format.sample, false));
+    for y in area.y0..area.y1 {
+        for x in area.x0..area.x1 {
+            if !format.alpha || source.sample_channel(x, y, format.channels().saturating_sub(1)) > 0.0 {
+                support.write_pixel(x, y, &[1.0]);
+            }
+        }
+    }
+    let bounds = support.content_bounds();
+    if bounds.is_empty() {
+        return Err(bad("the layer contains no visible pixels"));
+    }
+    if shape == "selection" {
+        return Ok(support);
+    }
+    let cx = (f64::from(bounds.x0) + f64::from(bounds.x1)) / 2.0;
+    let cy = (f64::from(bounds.y0) + f64::from(bounds.y1)) / 2.0;
+    let radius = f64::from(bounds.width().min(bounds.height())) / 2.0;
+    let mut mask = Surface::new(PixelFormat::new(ColorMode::Grayscale, format.sample, false));
+    for y in bounds.y0..bounds.y1 {
+        for x in bounds.x0..bounds.x1 {
+            let dx = (f64::from(x) + 0.5 - cx).abs();
+            let dy = (f64::from(y) + 0.5 - cy).abs();
+            let distance = if shape == "circle" { dx.hypot(dy) } else { dx.max(dy) };
+            let coverage = (radius + 0.5 - distance).clamp(0.0, 1.0) as f32;
+            if coverage > 0.0 && support.sample_channel(x, y, 0) > 0.0 {
+                mask.write_pixel(x, y, &[coverage]);
+            }
+        }
+    }
+    Ok(mask)
+}
