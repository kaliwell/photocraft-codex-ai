@@ -0,0 +1,126 @@
+//! Bounded fallback for ordinary Windows DIBs rejected by the primary clipboard decoder.
+type Image = (u32, u32, Vec<u8>);
+
+pub fn read() -> Option<Image> {
+    for format in [17, 8] {
+        if !clipboard_win::is_format_avail(format) {
+            continue;
+        }
+        let data: Vec<u8> = clipboard_win::get_clipboard(clipboard_win::formats::RawData(format)).ok()?;
+        if let Some(image) = dib(&data) {
+            return Some(image);
+        }
+    }
+    None
+}
+
+fn dib(data: &[u8]) -> Option<Image> {
+    let word = |offset: usize| -> Option<u32> { Some(u32::from_le_bytes(data.get(offset..offset.checked_add(4)?)?.try_into().ok()?)) };
+    let short = |offset: usize| -> Option<u16> { Some(u16::from_le_bytes(data.get(offset..offset.checked_add(2)?)?.try_into().ok()?)) };
+    let header = word(0)? as usize;
+    if ![40, 52, 56, 108, 124].contains(&header) || data.len() < header {
+        return None;
+    }
+    let width = i32::try_from(word(4)?).ok()? as usize;
+    let signed_height = word(8)? as i32;
+    let height = signed_height.checked_abs()? as usize;
+    let depth = short(14)? as usize;
+    let compression = word(16)?;
+    if width == 0 || height == 0 || short(12)? != 1 || ![24, 32].contains(&depth) || ![0, 3].contains(&compression) {
+        return None;
+    }
+    let size = width.checked_mul(height)?.checked_mul(4)?;
+    if size > 256 * 1024 * 1024 {
+        return None;
+    }
+    let mut offset = header;
+    let mut alpha = false;
+    if compression == 3 {
+        if depth != 32 {
+            return None;
+        }
+        let masks = [word(40)?, word(44)?, word(48)?];
+        if masks != [0xff0000, 0xff00, 0xff] {
+            return None;
+        }
+        if header == 40 {
+            offset = offset.checked_add(12)?;
+        }
+        if header >= 56 {
+            let mask = word(52)?;
+            if mask != 0 && mask != 0xff000000 {
+                return None;
+            }
+            alpha = mask != 0;
+        }
+    }
+    let colors = word(32)? as usize;
+    if colors > 256 {
+        return None;
+    }
+    offset = offset.checked_add(colors.checked_mul(4)?)?;
+    let stride = width.checked_mul(depth)?.checked_add(31)?.checked_div(32)?.checked_mul(4)?;
+    let pixels = data.get(offset..offset.checked_add(stride.checked_mul(height)?)?)?;
+    let mut rgba = vec![0; size];
+    for y in 0..height {
+        let row = if signed_height > 0 { height - 1 - y } else { y };
+        for x in 0..width {
+            let src = row * stride + x * (depth / 8);
+            let dst = (y * width + x) * 4;
+            rgba[dst..dst + 4].copy_from_slice(&[pixels[src + 2], pixels[src + 1], pixels[src], if alpha { pixels[src + 3] } else { 255 }]);
+        }
+    }
+    Some((width as u32, height as u32, rgba))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn sample(header: usize, top_down: bool, depth: u16) -> Vec<u8> {
+        let mut bytes = vec![0; header + 8];
+        bytes[..4].copy_from_slice(&(header as u32).to_le_bytes());
+        bytes[4..8].copy_from_slice(&1_i32.to_le_bytes());
+        bytes[8..12].copy_from_slice(&(if top_down { -2_i32 } else { 2_i32 }).to_le_bytes());
+        bytes[12..14].copy_from_slice(&1_u16.to_le_bytes());
+        bytes[14..16].copy_from_slice(&depth.to_le_bytes());
+        if header == 124 {
+            bytes[16..20].copy_from_slice(&3_u32.to_le_bytes());
+            for (offset, mask) in [(40, 0xff0000_u32), (44, 0xff00), (48, 0xff)] {
+                bytes[offset..offset + 4].copy_from_slice(&mask.to_le_bytes());
+            }
+        }
+        bytes[header..].copy_from_slice(&[0, 0, 255, 0, 255, 0, 0, 0]);
+        bytes
+    }
+    #[test]
+    fn bitmap_v5_without_alpha_and_bottom_up_dib_are_opaque() {
+        for header in [40, 124] {
+            let image = dib(&sample(header, false, 32)).unwrap();
+            assert_eq!(image, (1, 2, vec![0, 0, 255, 255, 255, 0, 0, 255]));
+        }
+    }
+    #[test]
+    fn top_down_padding_and_explicit_alpha_are_preserved() {
+        assert_eq!(dib(&sample(40, true, 24)).unwrap().2, vec![255, 0, 0, 255, 0, 0, 255, 255]);
+        let mut bytes = sample(124, true, 32);
+        bytes[52..56].copy_from_slice(&0xff000000_u32.to_le_bytes());
+        bytes[127] = 128;
+        assert_eq!(dib(&bytes).unwrap().2, vec![255, 0, 0, 128, 0, 0, 255, 0]);
+    }
+    #[test]
+    fn truncated_compressed_and_unbounded_headers_are_rejected() {
+        let mut bytes = sample(124, false, 32);
+        assert!(dib(&bytes[..127]).is_none());
+        bytes[4..8].copy_from_slice(&i32::MAX.to_le_bytes());
+        assert!(dib(&bytes).is_none());
+        let mut bytes = sample(40, false, 24);
+        bytes[16..20].copy_from_slice(&1_u32.to_le_bytes());
+        assert!(dib(&bytes).is_none());
+        assert!(dib(&[]).is_none());
+    }
+    #[test]
+    #[ignore = "Read-only check of the current Windows clipboard"]
+    fn current_clipboard_is_readable() {
+        assert!(read().is_some());
+    }
+}
