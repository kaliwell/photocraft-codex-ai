+fn pick_references(app: &mut PhotocraftApp, ctx: &Context) -> Result<Value, String> {
+    let ctx = ctx.clone();
+    let initial_dir = crate::file_dialog::last_used_dir(&app.ui.recent_files)
+        .or_else(|| std::env::var_os("USERPROFILE").map(|p| std::path::PathBuf::from(p).join("Desktop").to_string_lossy().into_owned()));
+    app.ask_file(
+        crate::FileDialogRequest::Open {
+            multiple: true,
+            initial_dir,
+            extensions: Some(["png", "jpg", "jpeg", "webp", "bmp", "gif", "tif", "tiff"].iter().map(|s| s.to_string()).collect()),
+        },
+        move |_, answer| queue_references(ctx, answer),
+    )
+}
+
+fn queue_references(ctx: Context, answer: crate::FileDialogAnswer) -> Result<Value, String> {
+    queue_reference_input(ctx, move || Ok(answer))
+}
