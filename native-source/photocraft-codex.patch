+            let raw =
+                egui::RawInput { screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1440.0, 900.0))), events, ..Default::default() };
+            let mut out = ctx.run_ui(raw, |_| show(app, &ctx));
+            out.textures_delta.clear();
+        };
+        draw(&mut app, vec![]);
+        draw(&mut app, vec![]);
+        let rect = app.long_cut.as_ref().unwrap().source_rect.unwrap();
+        let point = |row: f32| egui::pos2(rect.center().x, rect.top() + row / 1200.0 * rect.height());
+        let press = point(20.0);
+        let destination = point(50.0);
+        draw(
