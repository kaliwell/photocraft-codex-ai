-pub fn switch_damage(app: &mut PhotocraftApp, to: u64, region: Rect, visible: Rect) -> Rect {
-    let Some(p) = app.adjust_preview.as_mut() else { return region };
-    if to == 0 {
-        p.covered = None;
-        return region;
-    }
-    let shown = region.intersect(&visible);
-    p.covered = Some((to, shown));
-    shown
