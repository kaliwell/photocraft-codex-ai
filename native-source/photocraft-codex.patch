+fn feather_menu(app: &crate::PhotocraftApp, ui: &mut egui::Ui, layer: &Layer, actions: &mut Vec<(String, Value)>) {
+    let Some(document) = app.session.active().map(|s| s.doc.id.0) else { return };
+    let mut controls = json!({"layer": layer.id.0});
+    let label = |english, chinese| if crate::i18n::current().code().starts_with("zh") { chinese } else { english };
+    let config = egui::containers::menu::MenuConfig::new().close_behavior(egui::PopupCloseBehavior::CloseOnClickOutside);
+    let (menu, _) = egui::containers::menu::SubMenuButton::new(label("Edge Feather", "边缘羽化")).config(config).ui(ui, |ui| {
+        ui.set_width(280.0);
+        ui.label(label("Centered on original pixel coverage", "以原始像素选区为中心"));
+        ui.horizontal(|ui| {
+            for (text, shape) in [(label("Original", "原选区"), "selection"), (label("Circle", "圆形"), "circle"), (label("Square", "正方形"), "square")]
+            {
+                let response = ui.button(text);
+                controls[shape] = json!([response.rect.min.x, response.rect.min.y, response.rect.width(), response.rect.height()]);
+                if response.clicked() {
+                    actions.push(("layer.layerMask.edit".into(), json!({"document": document, "layer": layer.id.0, "shape": shape, "inward": true})));
+                }
+            }
+        });
+        let mut feather = layer.mask.as_ref().map_or(0.0, |m| m.feather);
+        let gesture_key = ui.scope_id().with((document, layer.id, "feather-gesture"));
+        let pressed = ui.input(|i| i.pointer.any_pressed());
+        let gesture = ui.data_mut(|data| {
+            let value = data.get_temp_mut_or_default::<u64>(gesture_key);
+            if pressed {
+                *value = value.wrapping_add(1);
+            }
+            *value
+        });
+        let response = crate::widgets::slider_row_with(
+            ui,
+            label("Feather", "羽化"),
+            &mut feather,
+            0.0..=1000.0,
+            "px",
+            None,
+            crate::widgets::RowGestures { curve: Some(3.0), ..Default::default() },
+        );
+        controls["slider"] = json!([response.rect.min.x, response.rect.min.y, response.rect.width(), response.rect.height()]);
+        controls["feather"] = json!(feather);
+        if response.changed() {
+            let mut params = json!({"document": document, "layer": layer.id.0, "feather": feather, "inward": true,
+                "coalesce": format!("mask-context:{document}:{}:{gesture}", layer.id.0)});
+            if layer.mask.is_none() {
+                params["shape"] = json!("selection");
+            }
+            actions.push(("layer.layerMask.edit".into(), params));
+            if !ui.input(|i| i.pointer.any_down()) {
+                ui.data_mut(|data| {
+                    let value = data.get_temp_mut_or_default::<u64>(gesture_key);
+                    *value = value.wrapping_add(1);
+                });
+            }
+        }
+        ui.label(
+            egui::RichText::new(label("0 restores hard edges; mask only", "调到 0 可恢复硬边；只改变蒙版")).color(crate::theme::Tokens::get(ui.ctx()).text_dim),
+        );
+    });
+    controls["menu"] = json!([menu.rect.min.x, menu.rect.min.y, menu.rect.width(), menu.rect.height()]);
+    controls["pass"] = json!(ui.ctx().cumulative_pass_nr());
+    ui.ctx().data_mut(|d| d.insert_temp(egui::Id::unique("mask-feather-menu"), controls));
+}
+
+pub(crate) fn inspect_feather_menu(ctx: &egui::Context) -> Value {
+    ctx.data(|d| d.get_temp::<Value>(egui::Id::unique("mask-feather-menu")))
+        .filter(|v| v.get("pass").and_then(Value::as_u64).is_some_and(|pass| ctx.cumulative_pass_nr().saturating_sub(pass) <= 1))
+        .unwrap_or(Value::Null)
+}
