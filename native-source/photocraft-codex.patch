+//! Custom tools share the editor's active language and translation catalogs.
+pub(crate) fn text(source: &str) -> String {
+    translate(&canonical(source, 0), 0)
+}
+fn translate(source: &str, depth: u8) -> String {
+    let lang = crate::i18n::current();
+    let direct = crate::i18n::tr(lang, source);
+    if direct != source {
+        return direct.to_owned();
+    }
+    if depth > 3 {
+        return source.to_owned();
+    }
+    for template in TEMPLATES {
+        if let Some(values) = capture(template, source) {
+            let translated = crate::i18n::tr(lang, template);
+            let mut pieces = translated.split("{}");
+            let mut result = pieces.next().unwrap_or("").to_owned();
+            for (value, part) in values.iter().zip(pieces) {
+                result.push_str(&translate(value, depth + 1));
+                result.push_str(part);
+            }
+            return result;
+        }
+    }
+    source.to_owned()
+}
+fn capture<'a>(pattern: &str, source: &'a str) -> Option<Vec<&'a str>> {
+    let parts: Vec<_> = pattern.split("{}").collect();
+    let mut remaining = source.strip_prefix(parts[0])?;
+    let mut values = Vec::new();
+    for (index, part) in parts.iter().enumerate().skip(1) {
+        if index == parts.len() - 1 {
+            values.push(remaining.strip_suffix(part)?);
+            remaining = "";
+        } else {
+            let at = remaining.find(part)?;
+            values.push(&remaining[..at]);
+            remaining = &remaining[at + part.len()..];
+        }
+    }
+    if remaining.is_empty() { Some(values) } else { None }
+}
+const TEMPLATES: &[&str] = &[
+    "Batch PSD {}/{}: {}",
+    "Batch PSD complete: {}/{}; {}",
+    "Unsupported layout fields: {}",
+    "Reference images selected: {}",
+    "Reference images {} +",
+    "Cannot read reference image: {}",
+    "Cannot connect to Codex service: {}",
+    "Auto-save failed: {}",
+    "{} × {} px · Slices: {} · {}",
+    "Added as a new layer · elapsed {} s · Ctrl+Z to undo",
+    "{} · waiting {} s",
+];
+
+fn canonical(source: &str, depth: u8) -> String {
+    if depth > 3 {
+        return source.to_owned();
+    }
+    for (chinese, english) in PAIRS {
+        if source == *chinese {
+            return english.to_string();
+        }
+        if chinese.contains("{}")
+            && let Some(values) = capture(chinese, source)
+        {
+            let mut pieces = english.split("{}");
+            let mut out = pieces.next().unwrap_or("").to_owned();
+            for (value, part) in values.iter().zip(pieces) {
+                out.push_str(&canonical(value, depth + 1));
+                out.push_str(part);
+            }
+            return out;
+        }
+    }
+    source.to_owned()
+}
