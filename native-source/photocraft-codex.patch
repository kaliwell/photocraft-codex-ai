+fn start(_ctx: &Context, _request: Value) {}
+#[cfg(target_arch = "wasm32")]
+fn cancel(_ctx: &Context) {}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn available() -> bool {
+    std::env::var_os("PHOTOCRAFT_CODEX_TOKEN_FILE").is_some()
+}
