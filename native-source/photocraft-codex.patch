+//! UI state as plain data, so the control channel (and later MCP) can read and drive every
+//! aspect of the interface: tools, zoom, panels, dialogs and windows.
+
+use serde::{Deserialize, Serialize};
+
+mod color_panel;
+mod panel_state;
