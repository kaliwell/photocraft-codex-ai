+#[cfg(not(target_arch = "wasm32"))]
+fn start(ctx: &Context, request: Value) {
+    let state = shared(ctx);
+    {
+        let mut status = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if status.busy {
+            return;
+        }
+        status.busy = true;
+        status.error = false;
+        status.message = "正在读取选区…".into();
+    }
+    let ctx = ctx.clone();
+    std::thread::spawn(move || {
+        let result = native::run(&ctx, &state, request);
+        if let Err(error) = result {
+            let mut status = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            status.busy = false;
+            status.error = true;
+            status.message = error;
+        }
+        ctx.request_repaint();
+    });
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn cancel(ctx: &Context) {
+    let ctx = ctx.clone();
+    std::thread::spawn(move || {
+        if let Err(error) = native::request("POST", "/cancel", &json!({})) {
+            let state = shared(&ctx);
+            state.lock().unwrap_or_else(std::sync::PoisonError::into_inner).message = error;
+        }
+        ctx.request_repaint();
+    });
+}
