 /// The `app.open` control method: opens a path through the configured automation read
 /// capability, with optional high-memory approval.
+fn adopt_reflow_path(app: &mut PhotocraftApp, p: &Value) -> Result<Value, String> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (app, p);
+        Err("not available on the web".into())
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        use std::path::Path;
+        let source = u64_param(p, "source").ok_or("missing source document")? as usize;
+        if app.session.active_index() == Some(source) {
+            return Err("source must remain unchanged".into());
+        }
+        let source_path = app.session.documents().get(source).and_then(|s| s.path.as_deref()).ok_or("source has no saved path")?;
+        let target = str_param(p, "path").ok_or("missing path")?;
+        let src = Path::new(source_path);
+        let dst = Path::new(target);
+        let parent = src.parent().ok_or("source has no parent")?.canonicalize().map_err(|e| e.to_string())?;
+        let actual = dst.canonicalize().map_err(|e| e.to_string())?;
+        let stem = src.file_stem().and_then(|s| s.to_str()).ok_or("invalid source name")?;
+        let prefix = format!("{stem}_自适应_");
+        if actual.parent() != Some(parent.as_path())
+            || !dst.file_name().and_then(|s| s.to_str()).is_some_and(|s| s.starts_with(&prefix) && s.ends_with(".psd"))
+            || !actual.is_file()
+        {
+            return Err("result must be a new sibling PSD of the source".into());
+        }
+        let state = app.session.active_mut().ok_or("no document")?;
+        if state.path.as_deref() != str_param(p, "exported") || state.revision != state.saved_revision {
+            return Err("exported reflow document changed before publication".into());
+        }
+        if !state
+            .path
+            .as_deref()
+            .and_then(|s| Path::new(s).file_name())
+            .and_then(|s| s.to_str())
+            .is_some_and(|s| s.starts_with("reflow-") && s.ends_with(".psd"))
+        {
+            return Err("active document is not an exported reflow copy".into());
+        }
+        let (doc, revision) = (state.doc.id, state.revision);
+        app.saved_automation(doc, revision, target, &[], false);
+        Ok(json!({"path":target}))
+    }
+}
