+    }
+    #[test]
+    fn narrow_canvas_clamps_left_and_right() {
+        let canvas = Rect::from_min_size(pos2(0.0, 0.0), vec2(400.0, 300.0));
+        let size = vec2(376.0, 104.0);
+        for x in [-500.0, 0.0, 800.0] {
+            let selection = Rect::from_min_size(pos2(x, 130.0), vec2(40.0, 40.0));
+            assert!(canvas.contains_rect(Rect::from_min_size(position(selection, canvas, size), size)));
+        }
