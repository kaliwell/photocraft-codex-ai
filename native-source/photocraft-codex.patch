+pub fn show(app: &mut PhotocraftApp, ctx: &Context, xf: ViewXform) {
+    if !available() {
+        return;
+    }
+    let status = shared(ctx);
+    {
+        let mut state = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.rect = None;
+        state.sidebar_rect = None;
+        state.input = None;
+        state.buttons.clear();
+        state.prompt_focused = false;
+        let context = history::document_context(app);
+        if state.history_context != context {
+            state.history_context = context;
+            state.history_rows.clear();
+            state.history_open = false;
+            state.history_prompt = None;
+            state.history_options = None;
+            state.history_references = None;
+        }
+        if let Some(prompt) = state.history_prompt.take() {
+            app.ui.codex_ai_prompt = prompt;
+            if let Some(options) = state.history_options.take() {
+                app.ui.codex_layout_options = options;
+            }
+            if let Some(references) = state.history_references.take() {
+                state.references = references;
+            }
+        }
+        state.current_prompt = app.ui.codex_ai_prompt.clone();
+    }
+    if !app.ui.dialogs.is_empty() || app.ui.shell.dialog.is_some() || app.long_cut.is_some() {
+        return;
+    }
+    let snapshot = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+    let Some(selection) = selection_rect(app, ctx, xf).or_else(|| snapshot.busy.then(|| Rect::from_center_size(xf.rect.center(), vec2(1.0, 1.0)))) else {
+        history::show(app, ctx);
+        layout_options::show(app, ctx);
+        return;
+    };
+    if !selection.intersects(xf.rect) || xf.rect.width() < 320.0 || xf.rect.height() < 150.0 {
+        return;
+    }
+    let toolbar_viewport = xf.rect;
+    let width = (toolbar_viewport.width() - 24.0).clamp(280.0, 480.0);
+    let size = vec2(
+        width,
+        if snapshot.sidebar_open { (xf.rect.height() - 24.0).min(650.0) } else { 180.0 + if snapshot.references.is_empty() { 0.0 } else { 102.0 } },
+    );
+    let anchor = position(selection, toolbar_viewport, size);
+    let tokens = Tokens::get(ctx);
+    let mut input_rect = None;
+    let mut prompt_focused = false;
+    let mut button_rects = Vec::new();
+    let area = egui::Area::new(egui::Id::unique("codex-ai-toolbar")).order(egui::Order::Foreground).fixed_pos(anchor).movable(false).show(ctx, |ui| {
+        ui.set_clip_rect(xf.rect);
+        egui::Frame::new().fill(tokens.card).stroke(egui::Stroke::new(1.0, tokens.card_border)).corner_radius(tokens.radius).inner_margin(10.0).show(
+            ui,
+            |ui| {
+                ui.set_width(width - 20.0);
+                if snapshot.sidebar_open {
+                    ui.set_min_height((xf.rect.height() - 60.0).clamp(120.0, 700.0));
+                }
+                egui::ScrollArea::vertical().id_salt("unified-tools-scroll").max_height((xf.rect.height() - 48.0).max(100.0)).show(ui, |ui| {
+                    let input = ui.add_enabled(
+                        !snapshot.busy && !snapshot.loading,
+                        egui::TextEdit::singleline(&mut app.ui.codex_ai_prompt)
+                            .hint_text(l("Describe what to edit or generate…"))
+                            .char_limit(4000)
+                            .desired_width(f32::INFINITY),
+                    );
+                    input_rect = Some(input.rect);
+                    prompt_focused = input.has_focus();
+                    button_rects.extend(actions(app, ui, &snapshot));
+                    sidebar::references(app, ctx, &snapshot, ui, &mut button_rects);
+                    button_rects.extend(sidebar::controls(app, ctx, &snapshot, ui));
+
+                    if snapshot.loading {
+                        ui.label(l("Loading reference images…"));
+                    }
+                    if snapshot.busy {
+                        ui.horizontal(|ui| {
+                            ui.spinner();
+                            widgets::elided_label(ui, &l(&snapshot.message), width - 65.0);
+                        });
+                    } else if !snapshot.message.is_empty() {
+                        let display = if snapshot.message.starts_with("PSD base layout saved:") { l("PSD base layout saved") } else { l(&snapshot.message) };
+                        let text = egui::RichText::new(display).color(if snapshot.error { tokens.danger } else { tokens.text_dim });
+                        ui.add(egui::Label::new(text).truncate()).on_hover_text(l(&snapshot.message));
+                    }
+                });
+            },
+        );
+    });
+    let mut state = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    state.rect = Some(area.response.rect);
+    state.input = input_rect;
+    state.buttons = button_rects;
+    state.prompt_focused = prompt_focused;
+    state.current_prompt = app.ui.codex_ai_prompt.clone();
+    drop(state);
+    history::show(app, ctx);
+    layout_options::show(app, ctx);
+}
