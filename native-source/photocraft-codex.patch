+        assert!(super::read_references(selected, &Context::default(), 0, 0).is_err());
+        let selected = crate::FileDialogAnswer::Contents("bad.png".into(), vec![1, 2, 3]);
+        assert!(super::read_references(selected, &Context::default(), 0, 0).is_err());
+    }
+    #[test]
+    fn reference_automation_paths_use_the_scoped_reader_and_reject_unknown_fields() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        let ctx = Context::default();
+        assert!(super::attach_request(&mut app, &ctx, &json!({"paths":["outside.png"]})).is_err());
+        app.services.automation_read = Some(Box::new(|_| Err("outside configured read roots".into())));
+        assert_eq!(super::attach_request(&mut app, &ctx, &json!({"paths":["outside.png"]})).unwrap_err(), "outside configured read roots");
+        assert!(super::attach_request(&mut app, &ctx, &json!({"paths":[],"extra":true})).is_err());
+        assert!(!super::shared(&ctx).lock().unwrap().loading);
+    }
+    #[test]
+    fn dropped_images_only_enter_the_composer_and_keep_virtual_file_order() {
+        #[derive(Debug)]
+        struct Drop(std::path::PathBuf, Vec<u8>);
+        impl egui::DroppedFile for Drop {
+            fn path(&self) -> &std::path::Path {
+                &self.0
+            }
+            fn bytes(&self) -> Result<Vec<u8>, String> {
+                Ok(self.1.clone())
+            }
+        }
+        let image = photocraft_codecs::Image::from_u8(8, 6, photocraft_codecs::ChannelLayout::Rgba, vec![128; 8 * 6 * 4]).unwrap();
+        let png = photocraft_codecs::encode(&image, photocraft_codecs::Format::Png, &Default::default()).unwrap();
+        let files: Vec<egui::DroppedFileHandle> =
+            (0..2).map(|i| std::sync::Arc::new(Drop(pt!("virtual-{i}.png").into(), png.clone())) as egui::DroppedFileHandle).collect();
+        let ctx = Context::default();
+        let shared = super::shared(&ctx);
+        shared.lock().unwrap().rect = Some(Rect::from_min_size(pos2(10.0, 10.0), vec2(100.0, 100.0)));
+        assert!(!super::accept_drop(&ctx, &files, Some(pos2(200.0, 200.0))));
+        assert!(super::accept_drop(&ctx, &files, Some(pos2(40.0, 40.0))));
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        while shared.lock().unwrap().loading && std::time::Instant::now() < deadline {
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+        let state = shared.lock().unwrap();
+        assert!(!state.loading);
+        assert!(!state.error, "{}", state.message);
+        assert_eq!(state.references.iter().map(|r| r.name.as_str()).collect::<Vec<_>>(), vec!["virtual-0.png", "virtual-1.png"]);
+    }
+    #[test]
+    fn prompt_defaults_preserve_upstream_move_tool() {
+        let ui = crate::state::UiState::default();
+        assert_eq!(ui.tool, crate::state::Tool::Move);
+        assert!(ui.codex_ai_prompt.is_empty());
+    }
+    #[test]
+    fn follows_selection_and_stays_inside_canvas() {
+        let canvas = Rect::from_min_max(pos2(50.0, 80.0), pos2(950.0, 700.0));
+        let size = vec2(560.0, 104.0);
+        let selection = Rect::from_min_max(pos2(300.0, 200.0), pos2(500.0, 300.0));
+        let normal = position(selection, canvas, size);
+        assert_eq!(normal.y, 312.0);
+        let bottom = position(selection.translate(vec2(0.0, 350.0)), canvas, size);
+        assert!(bottom.y + size.y < 550.0);
+        assert!(canvas.contains_rect(Rect::from_min_size(bottom, size)));
+    }
+    #[test]
+    fn narrow_canvas_clamps_left_and_right() {
+        let canvas = Rect::from_min_size(pos2(0.0, 0.0), vec2(400.0, 300.0));
+        let size = vec2(376.0, 104.0);
+        for x in [-500.0, 0.0, 800.0] {
+            let selection = Rect::from_min_size(pos2(x, 130.0), vec2(40.0, 40.0));
+            assert!(canvas.contains_rect(Rect::from_min_size(position(selection, canvas, size), size)));
+        }
+    }
+
+    #[test]
+    fn cached_bounds_follow_revisions_and_camera_changes() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        app.run("file.new", json!({"width": 400, "height": 300})).unwrap();
+        app.run("select.rect", json!({"x": 20, "y": 30, "width": 80, "height": 60})).unwrap();
+        let ctx = Context::default();
+        let xf = ViewXform {
+            rect: Rect::from_min_size(pos2(0.0, 0.0), vec2(400.0, 300.0)),
+            zoom: 1.0,
+            center: [200.0, 150.0],
+            flip: false,
+            rotation: 0.0,
+            aspect: 1.0,
+        };
+        assert_eq!(selection_rect(&app, &ctx, xf).unwrap().width(), 80.0);
+        assert_eq!(selection_rect(&app, &ctx, ViewXform { zoom: 2.0, ..xf }).unwrap().width(), 160.0);
+        app.run("select.rect", json!({"x": 40, "y": 50, "width": 100, "height": 70})).unwrap();
+        assert_eq!(selection_rect(&app, &ctx, xf).unwrap().width(), 100.0);
+        app.run("select.deselect", json!({})).unwrap();
+        assert!(selection_rect(&app, &ctx, xf).is_none());
+    }
+}
diff --git a/crates/ui-egui/src/codex_ai/history.rs b/crates/ui-egui/src/codex_ai/history.rs
new file mode 100644
index 0000000..1309977
--- /dev/null
+++ b/crates/ui-egui/src/codex_ai/history.rs
@@ -0,0 +1,177 @@
+use super::{Context, PhotocraftApp, Rect, Status, Value, json, l, shared};
+#[cfg(not(target_arch = "wasm32"))]
+use super::{MAX_REFERENCE_BYTES, MAX_REFERENCE_TOTAL};
+
+pub(super) fn document_context(app: &PhotocraftApp) -> Value {
+    app.session.active().map(|d| json!({"index":app.session.active_index(),"name":d.doc.name,"id":d.doc.id,"path":d.path})).unwrap_or(Value::Null)
+}
+fn draft(app: &PhotocraftApp, state: &Status) -> Value {
+    json!({"prompt":app.ui.codex_ai_prompt,"mode":"generate","document":document_context(app),"layout_options":super::layout_options::value(app),
+        "references":state.references.iter().map(|r|json!({"name":r.name,"data":r.data.as_str()})).collect::<Vec<_>>()})
+}
+
+pub(super) fn buttons(app: &PhotocraftApp, ui: &mut egui::Ui, state: &Status, buttons: &mut Vec<(String, Rect)>) {
+    for (label, path, enabled) in
+        [("History", "/history/list", true), ("Save draft", "/history/save", !app.ui.codex_ai_prompt.is_empty() || !state.references.is_empty())]
+    {
+        let b = ui.add_enabled(!state.busy && !state.loading && enabled, egui::Button::new(l(label)));
+        buttons.push((label.into(), b.rect));
+        if b.clicked() {
+            let shared = shared(ui.ctx());
+            shared.lock().unwrap_or_else(std::sync::PoisonError::into_inner).history_open = true;
+            request(ui.ctx(), path, draft(app, state));
+        }
+    }
+}
+
+pub(super) fn show(app: &PhotocraftApp, ctx: &Context) {
+    let state = shared(ctx);
+    let snapshot = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+    if !snapshot.history_open {
+        return;
+    }
+    let mut open = !ctx.input_mut(|i| i.consume_key(egui::Modifiers::NONE, egui::Key::Escape));
+    let mut restore = None;
+    let mut close = false;
+    let mut buttons = Vec::new();
+    egui::Window::new(format!("{} ? {}", l("Prompt and reference history"), app.session.active().map(|d| d.doc.name.as_str()).unwrap_or("")))
+        .id(egui::Id::unique("codex-history-window-side"))
+        .open(&mut open)
+        .order(egui::Order::Foreground)
+        .default_pos(egui::pos2((ctx.content_rect().right() - 470.0).max(0.0), 80.0))
+        .default_width(440.0)
+        .show(ctx, |ui| {
+            ui.label(l("Restoring changes inputs only and does not create a history entry. Save your draft first if needed."));
+            ui.label(l("Local history: up to 50 entries and 512 MiB. Older entries are removed automatically."));
+            if snapshot.loading {
+                ui.spinner();
+            }
+            if !snapshot.history_notice.is_empty() {
+                ui.label(l(&snapshot.history_notice));
+            }
+            if snapshot.history_rows.is_empty() {
+                ui.label(l("No saved history yet"));
+            }
+            egui::ScrollArea::vertical().max_height(420.0).show(ui, |ui| {
+                for row in &snapshot.history_rows {
+                    ui.group(|ui| {
+                        ui.horizontal_wrapped(|ui| {
+                            ui.label(row.get("display_time").and_then(Value::as_str).unwrap_or(""));
+                            let mode = match row.get("mode").and_then(Value::as_str) {
+                                Some("fill") => "Fill selection",
+                                Some("remove") => "Remove object",
+                                Some("layout") => "Reference to PSD",
+                                Some("detail") => "Detail page base",
+                                Some("batch") => "Batch references to PSD",
+                                Some("reflow") => "Adapt PSD ratio",
+                                _ => "Generate image",
+                            };
+                            ui.label(l(mode));
+                            ui.label(format!("{}: {}", l("Reference images"), row.get("references").and_then(Value::as_u64).unwrap_or(0)));
+                        });
+                        ui.label(row.get("prompt").and_then(Value::as_str).unwrap_or(""));
+                        let b = ui.add_enabled(!snapshot.busy && !snapshot.loading, egui::Button::new(l("Restore this draft")));
+                        if let Some(id) = row.get("id").and_then(Value::as_str) {
+                            buttons.push((format!("Restore history {id}"), b.rect));
+                            if b.clicked() {
+                                restore = Some(id.to_owned());
+                            }
+                        }
+                    });
+                }
+            });
+            let b = ui.button(l("Close"));
+            buttons.push(("Close history".into(), b.rect));
+            close = b.clicked();
+        });
+    if close {
+        open = false;
+    }
+    {
+        let mut s = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        s.history_open = open;
+        s.buttons.extend(buttons);
+    }
+    if let Some(id) = restore {
+        request(ctx, "/history/restore", json!({"id":id,"document":draft(app,&snapshot)["document"]}));
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+fn request(ctx: &Context, _path: &'static str, _body: Value) {
+    super::reference_error(ctx, l("Local history is unavailable in the web build"));
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn request(ctx: &Context, path: &'static str, body: Value) {
+    let state = shared(ctx);
+    {
+        let mut s = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if s.busy || s.loading {
+            return;
+        }
+        s.loading = true;
+    }
+    let ctx = ctx.clone();
+    std::thread::spawn(move || {
+        let result = super::native::request("POST", path, &body).and_then(|value| {
+            let restored = if path == "/history/restore" {
+                use base64::Engine;
+                let prompt = value.get("prompt").and_then(Value::as_str).filter(|p| p.chars().count() <= 4000).ok_or("Invalid history prompt")?.to_owned();
+                let refs = value.get("references").and_then(Value::as_array).ok_or("Invalid history references")?;
+                let mut total = 0;
+                let mut files = Vec::new();
+                for item in refs {
+                    let name = item.get("name").and_then(Value::as_str).ok_or("Invalid history reference name")?;
+                    let data = item.get("data").and_then(Value::as_str).ok_or("Invalid history reference data")?;
+                    if data.len() > MAX_REFERENCE_BYTES.div_ceil(3) * 4 {
+                        return Err("History reference is too large".into());
+                    }
+                    let bytes = base64::engine::general_purpose::STANDARD.decode(data).map_err(|e| e.to_string())?;
+                    total += bytes.len();
+                    if total > MAX_REFERENCE_TOTAL {
+                        return Err("History references are too large".into());
+                    }
+                    files.push((name.to_owned(), bytes));
+                }
+                Some((
+                    prompt,
+                    super::read_references(crate::FileDialogAnswer::ContentsMany(files), &ctx, 0, 0)?,
+                    value.get("layout_options").cloned().unwrap_or(Value::Null),
+                ))
+            } else {
+                None
+            };
+            Ok((value.get("entries").and_then(Value::as_array).cloned().unwrap_or_default(), restored))
+        });
+        {
+            let mut s = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            s.loading = false;
+            if s.history_context != body["document"] {
+                ctx.request_repaint();
+                return;
+            }
+            match result {
+                Ok((rows, restored)) => {
+                    s.history_rows = rows;
+                    s.error = false;
+                    s.history_notice.clear();
+                    if let Some((prompt, refs, options)) = restored {
+                        s.history_prompt = Some(prompt);
+                        s.history_options = Some(options);
+                        s.history_references = Some(refs);
+                        s.message = l("History restored");
+                    } else if path == "/history/save" {
+                        s.message = l("Draft saved");
+                    }
+                }
+                Err(error) => {
+                    s.error = error != "Save the project first to store history beside the project file";
+                    s.message = if !s.error { l("History requires saving the project first; PSD creation is still available.") } else { error.clone() };
+                    s.history_notice = error;
+                }
+            }
+        }
+        ctx.request_repaint();
+    });
+}
diff --git a/crates/ui-egui/src/codex_ai/layout_options.rs b/crates/ui-egui/src/codex_ai/layout_options.rs
new file mode 100644
index 0000000..82d3799
--- /dev/null
+++ b/crates/ui-egui/src/codex_ai/layout_options.rs
@@ -0,0 +1,173 @@
+//! Persisted parameters for editable reference-layout reconstruction.
+use super::{Context, PhotocraftApp, Value, l, shared};
+use crate::tools::type_tool::{FontLibrary, families, family_picker_in, fonts_ready, style_label, styles};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Default, Serialize, Deserialize)]
+#[serde(default)]
+struct TextStyle {
+    font: String,
+    font_style: String,
+    size: f32,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(default)]
+struct Settings {
+    reference_size: bool,
+    width: u32,
+    height: u32,
+    dpi: u32,
+    font: String,
+    font_style: String,
+    destination: String,
+    source: String,
+    text_styles: std::collections::BTreeMap<String, TextStyle>,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self {
+            reference_size: true,
+            width: 1500,
+            height: 1500,
+            dpi: 72,
+            font: String::new(),
+            font_style: String::new(),
+            destination: "new".into(),
+            source: "references".into(),
+            text_styles: std::collections::BTreeMap::new(),
+        }
+    }
+}
+pub(super) fn value(app: &PhotocraftApp) -> Value {
+    serde_json::to_value(settings(app)).unwrap_or_default()
+}
+pub(super) fn source_buttons(app: &mut PhotocraftApp, ui: &mut egui::Ui) -> bool {
+    let mut options = settings(app);
+    ui.horizontal_wrapped(|ui| {
+        ui.label(l("Layout source"));
+        ui.selectable_value(&mut options.source, "references".into(), l("Reference images"));
+        ui.selectable_value(&mut options.source, "layers".into(), l("Selected layers"));
+    });
+    let layers = options.source == "layers";
+    app.ui.codex_layout_options = serde_json::to_value(options).unwrap_or_default();
+    if layers { app.session.active().is_some_and(|d| !d.selected_layers().is_empty()) } else { false }
+}
+fn settings(app: &PhotocraftApp) -> Settings {
+    let mut settings: Settings = serde_json::from_value(app.ui.codex_layout_options.clone()).unwrap_or_default();
+    if settings.font.trim().is_empty() {
+        settings.font = app.ui.tool_options.type_font.clone();
+        settings.font_style = app.ui.tool_options.type_style.clone();
+    }
+    if settings.font_style.is_empty() {
+        settings.font_style = "Regular".into();
+    }
+    settings
+}
+pub(super) fn show(app: &mut PhotocraftApp, ctx: &Context) {
+    let state = shared(ctx);
+    let mut open = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner).settings_open;
+    if !open {
+        return;
+    }
+    egui::Window::new(l("PSD settings")).id(egui::Id::unique("codex-layout-settings")).open(&mut open).resizable(false).show(ctx, |ui| controls(app, ui));
+    state.lock().unwrap_or_else(std::sync::PoisonError::into_inner).settings_open = open;
+}
+pub(super) fn controls(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    let mut settings = settings(app);
+    ui.horizontal_wrapped(|ui| {
+        ui.label(l("Output"));
+        ui.selectable_value(&mut settings.destination, "new".into(), l("New document"));
+        ui.selectable_value(&mut settings.destination, "current".into(), l("Current document"));
+    });
+    if settings.destination == "current" {
+        ui.label(l("Uses current canvas dimensions and DPI. Adds layers on top; save the project when ready."));
+    } else {
+        ui.separator();
+        ui.checkbox(&mut settings.reference_size, l("Use reference image dimensions"));
+        ui.add_enabled_ui(!settings.reference_size, |ui| {
+            egui::Grid::new("layout-canvas-size").spacing([12.0, 6.0]).show(ui, |ui| {
+                ui.label(l("Canvas size"));
+                ui.horizontal(|ui| {
+                    ui.add(egui::DragValue::new(&mut settings.width).range(1..=8192).suffix(" px"));
+                    ui.label("×");
+                    ui.add(egui::DragValue::new(&mut settings.height).range(1..=8192).suffix(" px"));
+                });
+                ui.end_row();
+            });
+            ui.horizontal_wrapped(|ui| {
+                ui.label(l("Aspect ratio"));
+                for (label, w, h) in [("1:1", 1_u32, 1_u32), ("1:2", 1, 2), ("2:1", 2, 1), ("3:4", 3, 4), ("4:3", 4, 3)] {
+                    if ui.button(label).clicked() {
+                        settings.height = settings.width.saturating_mul(h).checked_div(w).unwrap_or(1).clamp(1, 8192);
+                        settings.width = settings.height.saturating_mul(w).checked_div(h).unwrap_or(1).clamp(1, 8192);
+                    }
+                }
+            });
+        });
+        ui.horizontal_wrapped(|ui| {
+            ui.label("DPI");
+            ui.add(egui::DragValue::new(&mut settings.dpi).range(36..=1200));
+            craft_ui::ComboBox::from_id_salt("psd-dpi-presets").selected_text(l("Presets")).show_ui(ui, |ui| {
+                for dpi in [72, 150, 300] {
+                    ui.selectable_value(&mut settings.dpi, dpi, dpi.to_string());
+                }
+            });
+        });
+    }
+    ui.separator();
+    ui.strong(l("Text styles"));
+    let role_id = egui::Id::unique("psd-text-style-role");
+    let mut role = ui.ctx().data_mut(|d| d.get_temp::<String>(role_id)).unwrap_or_else(|| "title".into());
+    ui.horizontal_wrapped(|ui| {
+        for (key, label) in [("title", "Title"), ("subtitle", "Subtitle"), ("body", "Body and small text")] {
+            ui.selectable_value(&mut role, key.into(), l(label));
+        }
+    });
+    ui.ctx().data_mut(|d| d.insert_temp(role_id, role.clone()));
+    let global_font = settings.font.clone();
+    let global_style = settings.font_style.clone();
+    let mut text_style = settings.text_styles.get(&role).cloned().unwrap_or_default();
+    if !text_style.font.is_empty() {
+        settings.font = text_style.font.clone();
+    }
+    if !text_style.font_style.is_empty() {
+        settings.font_style = text_style.font_style.clone();
+    }
+    ui.horizontal_wrapped(|ui| {
+        ui.label(l("Font family"));
+        if fonts_ready(ui, 290.0) {
+            let mut library = FontLibrary::of(app);
+            if family_picker_in(ui, "codex-layout-font", &mut settings.font, 170.0, &families(), app.session.prefs().type_.font_preview, &mut library) {
+                let available = styles(&settings.font);
+                if let Some(style) = library.picked_style.take().filter(|s| available.contains(s)) {
+                    settings.font_style = style;
+                } else if !available.contains(&settings.font_style) {
+                    settings.font_style = available.first().cloned().unwrap_or_else(|| "Regular".into());
+                }
+                app.note_recent_font(&settings.font);
+            }
+            library.finish(app);
+            let options: Vec<(String, String)> = styles(&settings.font).into_iter().map(|s| (s.clone(), style_label(&s))).collect();
+            let options_ref: Vec<(String, &str)> = options.iter().map(|(s, label)| (s.clone(), label.as_str())).collect();
+            crate::widgets::dropdown(ui, "codex-layout-style", &l("Style"), &mut settings.font_style, &options_ref, 110.0);
+        }
+    });
+    ui.horizontal(|ui| {
+        ui.label(l("Font size (px)"));
+        ui.add(egui::DragValue::new(&mut text_style.size).range(0.0..=1000.0));
+        if ui.button(l("Auto size")).clicked() {
+            text_style.size = 0.0;
+        }
+    });
+    ui.small(l("0 = automatic. Each text level keeps its own font, style and size."));
+    text_style.font = settings.font.clone();
+    text_style.font_style = settings.font_style.clone();
+    settings.text_styles.insert(role, text_style);
+    settings.font = global_font;
+    settings.font_style = global_style;
+    if settings.width.saturating_mul(settings.height) > 32_000_000 {
+        ui.colored_label(ui.visuals().error_fg_color, l("Maximum 32 million pixels"));
+    }
+
+    app.ui.codex_layout_options = serde_json::to_value(settings).unwrap_or_default();
+}
diff --git a/crates/ui-egui/src/codex_ai/sidebar.rs b/crates/ui-egui/src/codex_ai/sidebar.rs
new file mode 100644
index 0000000..d5cf362
--- /dev/null
+++ b/crates/ui-egui/src/codex_ai/sidebar.rs
@@ -0,0 +1,99 @@
+//! Canvas-side tools drawer; keeps the selection composer compact.
+use super::{Context, PhotocraftApp, Rect, Status, history, l, layout_options, paste_reference, pick_references, reference_error, shared, submit, vec2};
+pub(super) fn controls(app: &mut PhotocraftApp, ctx: &Context, snapshot: &Status, ui: &mut egui::Ui) -> Vec<(String, Rect)> {
+    let mut buttons = Vec::new();
+    if !snapshot.sidebar_open {
+        return buttons;
+    }
+    ui.separator();
+    ui.strong(l("PSD base layouts"));
+    let selected = ui.add_enabled_ui(!snapshot.busy && !snapshot.loading, |ui| layout_options::source_buttons(app, ui)).inner;
+    let ready = if layout_options::value(app)["source"] == "layers" { selected } else { !snapshot.references.is_empty() };
+    ui.add_enabled_ui(!snapshot.busy && !snapshot.loading, |ui| layout_options::controls(app, ui));
+    ui.separator();
+    ui.horizontal_wrapped(|ui| {
+        for (mode, label, id) in [("layout", "Create PSD base", "Reference to PSD"), ("detail", "Detail page base", "Detail page base")] {
+            let b = ui.add_enabled(ready && !snapshot.busy && !snapshot.loading, egui::Button::new(l(label)));
+            buttons.push((id.into(), b.rect));
+            if b.clicked() {
+                submit(app, ctx, mode);
+            }
+        }
+        let adapt = ui
+            .add_enabled(!snapshot.busy && !snapshot.loading && app.session.active().is_some(), egui::Button::new(l("Adapt PSD ratio")))
+            .on_hover_text(l("Recompose the current PSD at the specified width and height in a new copy."));
+        buttons.push(("Adapt PSD ratio".into(), adapt.rect));
+        if adapt.clicked() {
+            submit(app, ctx, "reflow");
+        }
+    });
+    let batch = ui.add_enabled(!snapshot.busy && !snapshot.loading && !snapshot.references.is_empty(), egui::Button::new(l("Batch references to PSD")));
+    buttons.push(("Batch references to PSD".into(), batch.rect));
+    if batch.clicked() {
+        submit(app, ctx, "batch");
+    }
+    ui.label(l("Batch converts each reference into a separate new PSD. Completed files are kept if cancelled."));
+    buttons
+}
+
+pub(super) fn references(app: &mut PhotocraftApp, ctx: &Context, snapshot: &Status, ui: &mut egui::Ui, button_rects: &mut Vec<(String, Rect)>) {
+    let status = shared(ctx);
+    ui.separator();
+    ui.label(egui::RichText::new(l("References and history")).strong());
+    ui.horizontal_wrapped(|ui| {
+        let add = ui
+            .add_enabled(
+                !snapshot.busy && !snapshot.loading && !app.file_dialog_open(),
+                egui::Button::new(pt!("Reference images {} +", snapshot.references.len())),
+            )
+            .on_hover_text(l("Select multiple images; refer to reference 1, reference 2, etc. in your prompt"));
+        button_rects.push(("添加参考图".into(), add.rect));
+        if add.clicked() {
+            let ctx = ui.ctx().clone();
+            if let Err(error) = pick_references(app, &ctx) {
+                let state = shared(&ctx);
+                let mut state = state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+                state.message = error;
+                state.error = true;
+            }
+        }
+        let paste = ui
+            .add_enabled(!snapshot.busy && !snapshot.loading, egui::Button::new(l("Paste reference image")))
+            .on_hover_text(l("Paste an image from the clipboard, or press Ctrl+V in the prompt"));
+        button_rects.push(("Paste reference image".into(), paste.rect));
+        if paste.clicked() {
+            let result = paste_reference(app, ctx);
+            if let Err(error) = result {
+                reference_error(ctx, error);
+            }
+        }
+
+        history::buttons(app, ui, snapshot, button_rects);
+    });
+    if !snapshot.references.is_empty() {
+        let mut remove = None;
+        egui::ScrollArea::horizontal().id_salt("codex-reference-strip").max_height(90.0).show(ui, |ui| {
+            ui.horizontal(|ui| {
+                for (index, reference) in snapshot.references.iter().enumerate() {
+                    ui.vertical(|ui| {
+                        let size = if snapshot.sidebar_open { 36.0 } else { 52.0 };
+                        ui.add(egui::Image::new(&reference.texture).max_size(vec2(size, size))).on_hover_text(&reference.name);
+                        let response = ui
+                            .add_enabled(!snapshot.busy && !snapshot.loading, egui::Button::new(pt!("{} ×", index + 1)))
+                            .on_hover_text(l("Remove this reference image"));
+                        button_rects.push((pt!("移除参考图{}", index + 1), response.rect));
+                        if response.clicked() {
+                            remove = Some(index);
+                        }
+                    });
+                }
+            });
+        });
+        if let Some(index) = remove {
+            let mut state = status.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.references.remove(index);
+            state.message = pt!("Reference images selected: {}", state.references.len());
+            state.error = false;
+        }
+    }
+}
